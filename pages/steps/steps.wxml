<view class="container steps-page" catchtouchmove="handleTouchMove">
  <view class="steps-header">
    <view class="header-copy">
      <text class="header-kicker">SHAKER DECK</text>
      <text class="header-title">{{cocktailName || '制作步骤'}}</text>
    </view>
    <view class="header-counter">
      <text class="counter-current">{{currentStepNumber}}</text>
      <text class="counter-total">/{{steps.length}}</text>
    </view>
  </view>

  <view class="progress-panel">
    <view class="progress-meta">
      <text class="progress-label">当前步骤</text>
      <text class="progress-value">{{currentProgress}}%</text>
    </view>
    <view class="progress-track">
      <view class="progress-fill" style="width: {{currentProgress}}%;"></view>
    </view>
  </view>

  <view
    class="deck-stage"
    bindtouchstart="handleTouchStart"
    bindtouchend="handleTouchEnd"
  >
    <view class="card-deck" wx:if="{{steps.length}}">
      <block wx:for="{{deckSteps}}" wx:key="deckKey">
        <view
          wx:if="{{item.isVisible}}"
          class="deck-card {{item.stackClass}} tone-{{item.tone}}"
          style="z-index: {{item.zIndex}};"
        >
          <view class="card-front">
            <view class="card-topline">
              <view>
                <text class="card-kicker">STEP {{item.displayNumber}}</text>
                <text wx:if="{{item.isCurrent}}" class="card-title">当前步骤</text>
                <text wx:else class="card-title card-title-preview">步骤预览</text>
              </view>
              <text class="card-position">{{item.positionText}}</text>
            </view>

            <view class="card-scroll">
              <text class="step-instruction">{{item.instruction}}</text>

              <view class="step-details">
                <view class="detail-pill" wx:if="{{item.estimatedTime}}">
                  <text class="detail-label">TIME</text>
                  <text class="detail-text">约 {{item.estimatedTime}} 分钟</text>
                </view>
                <view class="detail-note" wx:if="{{item.tips}}">
                  <text class="detail-label">TIP</text>
                  <text class="detail-text">{{item.tips}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>

    <view class="empty-state" wx:else>
      <text class="empty-title">暂无制作步骤</text>
      <text class="empty-copy">请返回配方页检查步骤内容。</text>
    </view>
  </view>

  <view class="step-dock" wx:if="{{steps.length}}">
    <view class="swipe-tip" wx:if="{{steps.length > 1}}">
      <view class="swipe-glyph">
        <text class="swipe-arrow-left"></text>
        <text class="swipe-arrow-right"></text>
      </view>
      <text>左右滑动切换步骤</text>
    </view>

    <view class="action-row {{currentStep === 0 ? 'is-first-step' : ''}} {{currentStep >= steps.length - 1 ? 'is-last-step' : ''}}">
      <button
        wx:if="{{currentStep > 0}}"
        class="step-action step-action-secondary"
        hover-class="step-action-press"
        bindtap="goPreviousStep"
      >
        <text class="action-arrow">‹</text>
        <text>上一步</text>
      </button>

      <button
        wx:if="{{currentStep < steps.length - 1}}"
        class="step-action step-action-primary"
        hover-class="step-action-press"
        bindtap="goNextStep"
      >
        <text>下一步</text>
        <text class="action-arrow">›</text>
      </button>

      <button
        wx:if="{{currentStep >= steps.length - 1}}"
        class="step-action step-action-primary"
        hover-class="step-action-press"
        bindtap="finishCocktail"
      >
        完成制作
      </button>
    </view>
  </view>

</view>
