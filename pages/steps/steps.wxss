.steps-page {
  min-height: 100vh;
  padding: 28rpx 24rpx 48rpx;
  box-sizing: border-box;
  overflow: hidden;
  background:
    radial-gradient(circle at 12% 12%, rgba(223, 58, 48, 0.2), transparent 30%),
    radial-gradient(circle at 88% 18%, rgba(215, 255, 104, 0.16), transparent 28%),
    linear-gradient(155deg, #16100d 0%, #25150f 46%, #10100d 100%);
}

.steps-page::before {
  content: "";
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  pointer-events: none;
  background-image:
    linear-gradient(rgba(255, 248, 238, 0.035) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(255, 248, 238, 0.028) 1rpx, transparent 1rpx);
  background-size: 46rpx 46rpx;
  opacity: 0.34;
}

.steps-header {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.header-copy {
  min-width: 0;
}

.header-kicker {
  display: block;
  margin-bottom: 14rpx;
  color: #d7ff68;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
}

.header-title {
  display: block;
  max-width: 480rpx;
  color: #fff8ee;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.12;
}

.header-counter {
  flex-shrink: 0;
  min-width: 118rpx;
  padding: 18rpx 18rpx 16rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  color: #17110e;
  text-align: center;
  background: #fff8ee;
  box-shadow: 8rpx 8rpx 0 #df3a30;
}

.counter-current {
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1;
}

.counter-total {
  color: rgba(23, 17, 14, 0.54);
  font-size: 24rpx;
  font-weight: 900;
}

.progress-panel {
  position: relative;
  z-index: 2;
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(255, 248, 238, 0.14);
  border-radius: 8rpx;
  background: rgba(255, 248, 238, 0.08);
  box-shadow: 0 18rpx 54rpx rgba(0, 0, 0, 0.24);
}

.progress-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.progress-label,
.progress-value {
  font-size: 24rpx;
  font-weight: 900;
}

.progress-label {
  color: rgba(255, 248, 238, 0.62);
}

.progress-value {
  color: #d7ff68;
}

.progress-track {
  height: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 248, 238, 0.14);
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #df3a30 0%, #ffbf52 48%, #d7ff68 100%);
  transition: width 0.3s ease;
}

.deck-stage {
  position: relative;
  z-index: 2;
  height: 760rpx;
  margin-top: 28rpx;
}

.card-deck {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
}

.deck-card {
  position: absolute;
  left: 82rpx;
  right: 82rpx;
  top: 34rpx;
  height: 650rpx;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 8rpx;
  border: 2rpx solid rgba(38, 24, 17, 0.84);
  transform-origin: 50% 86%;
  transition:
    transform 0.34s cubic-bezier(0.22, 0.86, 0.28, 1),
    opacity 0.24s ease,
    box-shadow 0.24s ease;
}

.deck-card::after {
  content: "";
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(23, 17, 14, 0.12);
}

.deck-card.is-current {
  opacity: 1;
  transform: translate3d(0, 0, 0) rotate(0deg) scale(1);
  box-shadow:
    0 36rpx 84rpx rgba(0, 0, 0, 0.34),
    0 0 0 1rpx rgba(255, 248, 238, 0.12);
}

.deck-card.is-prev {
  opacity: 0.92;
  transform: translate3d(-52rpx, 34rpx, 0) rotate(-6deg) scale(0.95);
  box-shadow: 0 24rpx 58rpx rgba(0, 0, 0, 0.24);
}

.deck-card.is-next {
  opacity: 0.92;
  transform: translate3d(52rpx, 34rpx, 0) rotate(6deg) scale(0.95);
  box-shadow: 0 24rpx 58rpx rgba(0, 0, 0, 0.24);
}

.deck-card.is-far-prev {
  opacity: 0.62;
  transform: translate3d(-86rpx, 82rpx, 0) rotate(-10deg) scale(0.9);
}

.deck-card.is-far-next {
  opacity: 0.62;
  transform: translate3d(86rpx, 82rpx, 0) rotate(10deg) scale(0.9);
}

.card-front,
.card-back {
  position: relative;
  min-height: 100%;
  box-sizing: border-box;
}

.card-front {
  display: flex;
  flex-direction: column;
  padding: 34rpx 34rpx 44rpx;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.68), rgba(255, 255, 255, 0)),
    #fff4df;
}

.card-front::before {
  content: "";
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 24rpx;
  bottom: 24rpx;
  border: 2rpx solid rgba(38, 24, 17, 0.12);
  border-radius: 6rpx;
  pointer-events: none;
}

.card-front::after {
  content: "";
  position: absolute;
  right: -64rpx;
  top: -66rpx;
  width: 188rpx;
  height: 188rpx;
  border-radius: 50%;
  background: rgba(223, 58, 48, 0.15);
}

.card-topline {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 52rpx;
}

.card-kicker {
  display: block;
  margin-bottom: 14rpx;
  color: #df3a30;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
}

.card-title {
  display: block;
  color: #1d1410;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.08;
}

.card-position {
  flex-shrink: 0;
  padding: 12rpx 14rpx;
  border-radius: 999rpx;
  background: #1d1410;
  color: #fff4df;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
}

.card-scroll {
  position: relative;
  z-index: 1;
  flex: 1;
  min-height: 0;
}

.step-instruction {
  display: block;
  color: #1b1512;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.48;
}

.step-details {
  position: relative;
  z-index: 1;
  margin-top: 30rpx;
}

.detail-pill,
.detail-note {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(29, 20, 16, 0.14);
  background: rgba(29, 20, 16, 0.06);
}

.detail-note {
  margin-top: 14rpx;
}

.detail-label {
  flex-shrink: 0;
  color: #df3a30;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.5;
}

.detail-text {
  flex: 1;
  min-width: 0;
  color: rgba(29, 20, 16, 0.72);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.5;
}

.card-back {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background:
    linear-gradient(45deg, rgba(255, 248, 238, 0.16) 25%, transparent 25%),
    linear-gradient(-45deg, rgba(255, 248, 238, 0.16) 25%, transparent 25%),
    linear-gradient(135deg, #3a1914 0%, #1b1512 100%);
  background-size: 36rpx 36rpx, 36rpx 36rpx, 100% 100%;
}

.card-back::before {
  content: "";
  position: absolute;
  left: 26rpx;
  right: 26rpx;
  top: 26rpx;
  bottom: 26rpx;
  border: 2rpx solid rgba(255, 248, 238, 0.26);
  border-radius: 6rpx;
}

.back-mark {
  color: rgba(255, 248, 238, 0.58);
  font-size: 22rpx;
  font-weight: 900;
}

.back-number {
  margin-top: 12rpx;
  color: #d7ff68;
  font-size: 86rpx;
  font-weight: 900;
  line-height: 1;
}

.tone-1 .card-front {
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.64), rgba(255, 255, 255, 0)),
    #f7f1e8;
}

.tone-2 .card-front {
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.62), rgba(255, 255, 255, 0)),
    #f1e2c3;
}

.tone-3 .card-front {
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.64), rgba(255, 255, 255, 0)),
    #ffe8d2;
}

.side-nav {
  position: absolute;
  top: 50%;
  z-index: 40;
  width: 76rpx;
  min-height: 178rpx;
  margin: 0;
  padding: 18rpx 12rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  background: #d7ff68;
  color: #16100d;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.12;
  box-shadow: 0 20rpx 48rpx rgba(0, 0, 0, 0.28);
  transform: translateY(-50%);
}

.side-nav text {
  display: block;
}

.side-nav-left {
  left: 0;
}

.side-nav-right {
  right: 0;
}

.side-nav-press {
  transform: translateY(-50%) scale(0.96);
  background: #ffbf52;
}

.empty-state {
  min-height: 520rpx;
  padding: 80rpx 40rpx;
  box-sizing: border-box;
  border: 1rpx dashed rgba(255, 248, 238, 0.28);
  border-radius: 8rpx;
  background: rgba(255, 248, 238, 0.06);
  text-align: center;
}

.empty-title {
  display: block;
  color: #fff8ee;
  font-size: 34rpx;
  font-weight: 900;
}

.empty-copy {
  display: block;
  margin-top: 14rpx;
  color: rgba(255, 248, 238, 0.62);
  font-size: 26rpx;
}

.step-footer {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 2rpx;
}

.footer-hint {
  display: flex;
  align-items: center;
  min-width: 0;
  color: rgba(255, 248, 238, 0.64);
  font-size: 24rpx;
  font-weight: 800;
}

.hint-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #d7ff68;
  box-shadow: 0 0 0 8rpx rgba(215, 255, 104, 0.12);
}

.finish-button {
  flex-shrink: 0;
  width: 218rpx;
  height: 82rpx;
  line-height: 82rpx;
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  background: #fff8ee;
  color: #16100d;
  font-size: 27rpx;
  font-weight: 900;
  box-shadow: 8rpx 8rpx 0 #df3a30;
}

.finish-button-press {
  transform: translate(4rpx, 4rpx);
  box-shadow: 4rpx 4rpx 0 #df3a30;
}

@media (max-width: 750rpx) {
  .header-title {
    max-width: 430rpx;
    font-size: 40rpx;
  }

  .deck-stage {
    height: 720rpx;
  }

  .deck-card {
    left: 78rpx;
    right: 78rpx;
    height: 620rpx;
  }

  .step-instruction {
    font-size: 32rpx;
  }
}
