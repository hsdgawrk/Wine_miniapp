.steps-page,
page {
  height: 100vh;
  overflow: hidden;
}

.steps-page {
  display: flex;
  flex-direction: column;
  padding: 24rpx 24rpx 28rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 12% 12%, rgba(223, 58, 48, 0.2), transparent 30%),
    radial-gradient(circle at 88% 18%, rgba(215, 255, 104, 0.16), transparent 28%),
    linear-gradient(155deg, #16100d 0%, #25150f 46%, #10100d 100%);
}

.steps-page::before {
  content: "";
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  pointer-events: none;
  background-image:
    linear-gradient(rgba(255, 248, 238, 0.035) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(255, 248, 238, 0.028) 1rpx, transparent 1rpx);
  background-size: 46rpx 46rpx;
  opacity: 0.34;
}

.steps-header {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.header-copy {
  min-width: 0;
}

.header-kicker {
  display: block;
  margin-bottom: 14rpx;
  color: #d7ff68;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
}

.header-title {
  display: block;
  max-width: 480rpx;
  color: #fff8ee;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.12;
}

.header-counter {
  flex-shrink: 0;
  min-width: 118rpx;
  padding: 18rpx 18rpx 16rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  color: #17110e;
  text-align: center;
  background: #fff8ee;
  box-shadow: 8rpx 8rpx 0 #df3a30;
}

.counter-current {
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1;
}

.counter-total {
  color: rgba(23, 17, 14, 0.54);
  font-size: 24rpx;
  font-weight: 900;
}

.progress-panel {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(255, 248, 238, 0.14);
  border-radius: 8rpx;
  background: rgba(255, 248, 238, 0.08);
  box-shadow: 0 18rpx 54rpx rgba(0, 0, 0, 0.24);
}

.progress-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.progress-label,
.progress-value {
  font-size: 24rpx;
  font-weight: 900;
}

.progress-label {
  color: rgba(255, 248, 238, 0.62);
}

.progress-value {
  color: #d7ff68;
}

.progress-track {
  height: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 248, 238, 0.14);
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #df3a30 0%, #ffbf52 48%, #d7ff68 100%);
  transition: width 0.3s ease;
}

.deck-stage {
  position: relative;
  z-index: 2;
  flex: 1;
  min-height: 0;
  margin-top: 20rpx;
}

.card-deck {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
}

.deck-card {
  position: absolute;
  left: 74rpx;
  right: 74rpx;
  top: 20rpx;
  bottom: 20rpx;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 8rpx;
  border: 2rpx solid rgba(38, 24, 17, 0.84);
  transform-origin: 50% 86%;
  transition:
    transform 0.34s cubic-bezier(0.22, 0.86, 0.28, 1),
    opacity 0.24s ease,
    filter 0.24s ease,
    box-shadow 0.24s ease;
}

.deck-card::after {
  content: "";
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(23, 17, 14, 0.12);
}

.deck-card.is-current {
  opacity: 1;
  filter: none;
  transform: translate3d(0, 0, 0) rotate(0deg) scale(1);
  box-shadow:
    0 36rpx 84rpx rgba(0, 0, 0, 0.34),
    0 0 0 1rpx rgba(255, 248, 238, 0.12);
}

.deck-card.is-prev {
  opacity: 0.58;
  filter: blur(4rpx);
  transform: translate3d(-52rpx, 34rpx, 0) rotate(-6deg) scale(0.95);
  box-shadow: 0 24rpx 58rpx rgba(0, 0, 0, 0.24);
  pointer-events: none;
}

.deck-card.is-next {
  opacity: 0.58;
  filter: blur(4rpx);
  transform: translate3d(52rpx, 34rpx, 0) rotate(6deg) scale(0.95);
  box-shadow: 0 24rpx 58rpx rgba(0, 0, 0, 0.24);
  pointer-events: none;
}

.deck-card.is-far-prev {
  opacity: 0.28;
  filter: blur(8rpx);
  transform: translate3d(-86rpx, 82rpx, 0) rotate(-10deg) scale(0.9);
  pointer-events: none;
}

.deck-card.is-far-next {
  opacity: 0.28;
  filter: blur(8rpx);
  transform: translate3d(86rpx, 82rpx, 0) rotate(10deg) scale(0.9);
  pointer-events: none;
}

.is-prev .card-front::after,
.is-next .card-front::after,
.is-far-prev .card-front::after,
.is-far-next .card-front::after {
  background: rgba(22, 16, 13, 0.1);
}

.is-prev .card-title,
.is-next .card-title,
.is-far-prev .card-title,
.is-far-next .card-title,
.is-prev .step-instruction,
.is-next .step-instruction,
.is-far-prev .step-instruction,
.is-far-next .step-instruction,
.is-prev .detail-text,
.is-next .detail-text,
.is-far-prev .detail-text,
.is-far-next .detail-text {
  color: rgba(29, 20, 16, 0.5);
}

.is-prev .step-instruction,
.is-next .step-instruction,
.is-far-prev .step-instruction,
.is-far-next .step-instruction {
  font-size: 31rpx;
  line-height: 1.42;
}

.card-front {
  position: relative;
  min-height: 100%;
  box-sizing: border-box;
}

.card-front {
  display: flex;
  flex-direction: column;
  padding: 34rpx 34rpx 44rpx;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.68), rgba(255, 255, 255, 0)),
    #fff4df;
}

.card-front::before {
  content: "";
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 24rpx;
  bottom: 24rpx;
  border: 2rpx solid rgba(38, 24, 17, 0.12);
  border-radius: 6rpx;
  pointer-events: none;
}

.card-front::after {
  content: "";
  position: absolute;
  right: -64rpx;
  top: -66rpx;
  width: 188rpx;
  height: 188rpx;
  border-radius: 50%;
  background: rgba(223, 58, 48, 0.15);
}

.card-topline {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 52rpx;
}

.card-kicker {
  display: block;
  margin-bottom: 14rpx;
  color: #df3a30;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
}

.card-title {
  display: block;
  color: #1d1410;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.08;
}

.card-title-preview {
  color: rgba(29, 20, 16, 0.58);
}

.card-position {
  flex-shrink: 0;
  padding: 12rpx 14rpx;
  border-radius: 999rpx;
  background: #1d1410;
  color: #fff4df;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
}

.card-scroll {
  position: relative;
  z-index: 1;
  flex: 1;
  min-height: 0;
}

.step-instruction {
  display: block;
  color: #1b1512;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.48;
}

.step-details {
  position: relative;
  z-index: 1;
  margin-top: 30rpx;
}

.detail-pill,
.detail-note {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(29, 20, 16, 0.14);
  background: rgba(29, 20, 16, 0.06);
}

.detail-note {
  margin-top: 14rpx;
}

.detail-label {
  flex-shrink: 0;
  color: #df3a30;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.5;
}

.detail-text {
  flex: 1;
  min-width: 0;
  color: rgba(29, 20, 16, 0.72);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.5;
}

.tone-1 .card-front {
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.64), rgba(255, 255, 255, 0)),
    #f7f1e8;
}

.tone-2 .card-front {
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.62), rgba(255, 255, 255, 0)),
    #f1e2c3;
}

.tone-3 .card-front {
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.64), rgba(255, 255, 255, 0)),
    #ffe8d2;
}

.empty-state {
  min-height: 520rpx;
  padding: 80rpx 40rpx;
  box-sizing: border-box;
  border: 1rpx dashed rgba(255, 248, 238, 0.28);
  border-radius: 8rpx;
  background: rgba(255, 248, 238, 0.06);
  text-align: center;
}

.empty-title {
  display: block;
  color: #fff8ee;
  font-size: 34rpx;
  font-weight: 900;
}

.empty-copy {
  display: block;
  margin-top: 14rpx;
  color: rgba(255, 248, 238, 0.62);
  font-size: 26rpx;
}

.step-dock {
  position: relative;
  z-index: 3;
  flex-shrink: 0;
  margin: 6rpx 26rpx 0;
  padding: 22rpx 22rpx 24rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 248, 238, 0.14);
  border-radius: 8rpx;
  background:
    linear-gradient(135deg, rgba(255, 248, 238, 0.12), rgba(255, 248, 238, 0.04)),
    rgba(15, 12, 10, 0.72);
  box-shadow: 0 20rpx 58rpx rgba(0, 0, 0, 0.26);
}

.swipe-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  min-height: 36rpx;
  margin-bottom: 18rpx;
  color: rgba(255, 248, 238, 0.66);
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.2;
}

.swipe-glyph {
  position: relative;
  width: 54rpx;
  height: 24rpx;
}

.swipe-glyph::before {
  content: "";
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  top: 11rpx;
  height: 2rpx;
  background: rgba(215, 255, 104, 0.7);
}

.swipe-glyph text {
  position: absolute;
  top: 4rpx;
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid #d7ff68;
  border-left: 3rpx solid #d7ff68;
  box-sizing: border-box;
}

.swipe-arrow-left {
  left: 0;
  transform: rotate(-45deg);
}

.swipe-arrow-right {
  right: 0;
  transform: rotate(135deg);
}

.action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.action-row.is-first-step,
.action-row.is-last-step {
  justify-content: center;
}

.step-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
  height: 78rpx;
  margin: 0;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 78rpx;
}

.step-action::after {
  border: 0;
}

.action-row.is-first-step .step-action,
.action-row.is-last-step .step-action {
  max-width: 420rpx;
}

.step-action-primary {
  background: #d7ff68;
  color: #16100d;
  box-shadow: 8rpx 8rpx 0 #df3a30;
}

.step-action-secondary {
  border: 1rpx solid rgba(255, 248, 238, 0.22);
  background: rgba(255, 248, 238, 0.12);
  color: #fff8ee;
  box-shadow: inset 0 0 0 1rpx rgba(255, 248, 238, 0.04);
}

.action-arrow {
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1;
}

.step-action-press {
  transform: scale(0.97);
  background: #ffbf52;
  color: #16100d;
}

@media (max-width: 750rpx) {
  .header-title {
    max-width: 430rpx;
    font-size: 40rpx;
  }

  .deck-stage {
    min-height: 0;
  }

  .deck-card {
    left: 70rpx;
    right: 70rpx;
  }

  .step-dock {
    margin-left: 6rpx;
    margin-right: 6rpx;
    padding: 20rpx 18rpx 22rpx;
  }

  .step-instruction {
    font-size: 32rpx;
  }
}
