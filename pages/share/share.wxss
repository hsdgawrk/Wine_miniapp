.share-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 40rpx;
  box-sizing: border-box;
  background:
    linear-gradient(135deg, rgba(215, 255, 104, 0.07), transparent 30%),
    linear-gradient(180deg, #171512 0%, #11100e 56%, #1b1813 100%);
}

.share-ticket {
  position: relative;
  padding: 34rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background:
    linear-gradient(135deg, rgba(255, 184, 77, 0.24), transparent 46%),
    rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  box-shadow: 0 24rpx 70rpx rgba(0, 0, 0, 0.28);
}

.share-ticket::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 8rpx;
  background: linear-gradient(90deg, #d7ff68, #ffb84d, #fff8ee);
}

.ticket-kicker {
  display: block;
  color: #d7ff68;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
  margin-bottom: 18rpx;
}

.ticket-title {
  display: block;
  color: #fff8ee;
  font-size: 50rpx;
  font-weight: 900;
  line-height: 1.1;
  margin-bottom: 16rpx;
}

.ticket-desc {
  display: -webkit-box;
  color: rgba(247, 241, 232, 0.68);
  font-size: 26rpx;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.ticket-line {
  height: 1rpx;
  margin: 28rpx 0 22rpx;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.24), transparent);
}

.ticket-code {
  display: block;
  color: rgba(247, 241, 232, 0.72);
  font-size: 24rpx;
  font-weight: 900;
  word-break: break-all;
}

.share-methods,
.code-section,
.qrcode-section,
.tips-section {
  margin-top: 18rpx;
  padding: 30rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.075);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 16rpx 46rpx rgba(0, 0, 0, 0.18);
}

.section-title,
.tip-title {
  display: block;
  color: #fff8ee;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.2;
  margin-bottom: 22rpx;
}

.method-card {
  display: flex;
  align-items: center;
  min-height: 116rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.075);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  margin-bottom: 14rpx;
}

.method-card:last-child {
  margin-bottom: 0;
}

.method-card.active {
  border-color: rgba(215, 255, 104, 0.44);
  background: rgba(215, 255, 104, 0.08);
}

.method-card:active {
  transform: scale(0.985);
}

.method-icon {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  margin-right: 18rpx;
}

.method-icon-text {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #fff8ee;
  color: #15130f;
  font-size: 30rpx;
  font-weight: 900;
}

.method-copy {
  flex: 1;
  min-width: 0;
}

.method-title {
  display: block;
  color: #fff8ee;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.2;
  margin-bottom: 8rpx;
}

.method-desc {
  display: block;
  color: rgba(247, 241, 232, 0.58);
  font-size: 24rpx;
  line-height: 1.4;
}

.method-arrow {
  flex-shrink: 0;
  color: #d7ff68;
  font-size: 30rpx;
  font-weight: 900;
  margin-left: 12rpx;
}

.code-label {
  display: block;
  color: rgba(247, 241, 232, 0.48);
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
  margin-bottom: 18rpx;
}

.share-code {
  display: block;
  padding: 22rpx;
  border-radius: 14rpx;
  background: rgba(0, 0, 0, 0.24);
  color: #d7ff68;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.25;
  text-align: center;
  word-break: break-all;
  margin-bottom: 24rpx;
}

.share-path-card {
  text-align: left;
}

.share-path {
  display: block;
  padding: 22rpx;
  margin-bottom: 24rpx;
  border-radius: 14rpx;
  background: rgba(0, 0, 0, 0.24);
  color: rgba(247, 241, 232, 0.78);
  font-size: 24rpx;
  line-height: 1.6;
  word-break: break-all;
}

.copy-button {
  height: 84rpx;
  line-height: 84rpx;
  padding: 0;
  border-radius: 16rpx;
  background: #d7ff68;
  color: #15130f;
  font-size: 28rpx;
  font-weight: 900;
  box-shadow: 0 18rpx 42rpx rgba(215, 255, 104, 0.18);
}

.copy-button:active {
  transform: scale(0.98);
}

.qrcode-image {
  width: 400rpx;
  height: 400rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.08);
}

.qrcode-tips,
.tip-content {
  display: block;
  color: rgba(247, 241, 232, 0.62);
  font-size: 25rpx;
  line-height: 1.58;
}

.tips-section {
  border-left: 6rpx solid #d7ff68;
}

.error-page {
  padding-top: 88rpx;
}

@media (max-width: 750rpx) {
  .share-page {
    padding-left: 20rpx;
    padding-right: 20rpx;
  }

  .share-ticket,
  .share-methods,
  .code-section,
  .qrcode-section,
  .tips-section {
    padding-left: 26rpx;
    padding-right: 26rpx;
  }
}
