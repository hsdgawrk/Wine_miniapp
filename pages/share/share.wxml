<view class="container share-page" wx:if="{{!error}}">
  <view class="share-ticket">
    <text class="ticket-kicker">SHARE TICKET</text>
    <text class="ticket-title">{{cocktail.name}}</text>
    <text class="ticket-desc">{{cocktail.description}}</text>
    <view class="ticket-line"></view>
    <text class="ticket-code">{{shareCode}}</text>
  </view>

  <view class="share-methods">
    <text class="section-title">选择分享方式</text>

    <view
      class="method-card {{showQrCode ? 'active' : ''}}"
      bindtap="onMethodSelect"
      data-method="qrcode"
    >
      <view class="method-icon method-icon-text">QR</view>
      <view class="method-copy">
        <text class="method-title">路径分享</text>
        <text class="method-desc">复制小程序路径，好友可直达配方</text>
      </view>
      <text class="method-arrow">→</text>
    </view>

    <view
      class="method-card {{showCode ? 'active' : ''}}"
      bindtap="onMethodSelect"
      data-method="code"
    >
      <view class="method-icon method-icon-text">#</view>
      <view class="method-copy">
        <text class="method-title">口令分享</text>
        <text class="method-desc">复制短口令，适合聊天转发</text>
      </view>
      <text class="method-arrow">→</text>
    </view>
  </view>

  <view class="code-section" wx:if="{{showCode}}">
    <text class="code-label">专属口令</text>
    <text class="share-code">{{shareCode}}</text>
    <button class="copy-button" bindtap="copyShareCode">复制口令</button>
  </view>

  <view class="qrcode-section" wx:if="{{showQrCode}}">
    <image
      wx:if="{{shareImageUrl}}"
      class="qrcode-image"
      src="{{shareImageUrl}}"
      mode="aspectFit"
      bindtap="previewShareImage"
    />
    <view wx:else class="share-path-card">
      <text class="code-label">小程序路径</text>
      <text class="share-path">{{sharePath}}</text>
      <button class="copy-button" bindtap="copySharePath">复制路径</button>
    </view>
    <text class="qrcode-tips">复制后可发送给好友打开对应配方</text>
  </view>

  <view class="tips-section">
    <text class="tip-title">分享提示</text>
    <text class="tip-content">路径适合精准打开配方，口令适合在聊天中快速传递。</text>
  </view>
</view>

<view class="container share-page error-page" wx:else>
  <view class="tips-section">
    <text class="tip-title">分享不可用</text>
    <text class="tip-content">{{error}}</text>
  </view>
</view>
