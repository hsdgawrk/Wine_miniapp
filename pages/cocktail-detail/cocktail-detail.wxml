<view class="container detail-page" wx:if="{{cocktail}}">
  <view class="detail-hero">
    <view class="hero-copy">
      <text class="hero-eyebrow">{{cocktail.category || 'COCKTAIL FILE'}}</text>
      <text class="cocktail-name">{{cocktail.name}}</text>
      <text class="cocktail-desc">{{cocktail.description}}</text>
    </view>
    <view class="hero-mark">
      <text class="hero-emoji">{{cocktail.emoji || '🍸'}}</text>
    </view>
  </view>

  <view class="quick-meta">
    <view class="meta-cell">
      <text class="meta-label">难度</text>
      <text class="meta-value">{{cocktail.difficulty || '未标注'}}</text>
    </view>
    <view class="meta-cell">
      <text class="meta-label">时间</text>
      <text class="meta-value">{{cocktail.time || '未设置'}}</text>
    </view>
    <view class="meta-cell">
      <text class="meta-label">来源</text>
      <text class="meta-value">{{cocktail.source === 'custom' ? '私藏' : '馆藏'}}</text>
    </view>
  </view>

  <view class="detail-section">
    <text class="section-kicker">PROFILE</text>
    <text class="section-title">风味小记</text>
    <text class="section-body">{{cocktail.description}}</text>
  </view>

  <view class="detail-section" wx:if="{{cocktail.ingredients && cocktail.ingredients.length}}">
    <text class="section-kicker">INGREDIENTS</text>
    <text class="section-title">所需材料</text>
    <view class="ingredient-grid">
      <text
        class="ingredient-chip"
        wx:for="{{cocktail.ingredients}}"
        wx:key="index"
      >{{item}}</text>
    </view>
  </view>

  <view class="detail-section" wx:if="{{cocktail.source === 'built-in' && cocktail.history}}">
    <text class="section-kicker">ORIGIN</text>
    <text class="section-title">酒款来历</text>
    <text class="section-body">{{cocktail.history}}</text>
  </view>

  <view class="action-dock">
    <button class="primary-button" bindtap="navigateToSteps">开始调制</button>
    <view class="action-gap"></view>
    <button class="secondary-button" bindtap="openMorePanel">更多</button>
  </view>

  <view
    wx:if="{{showMorePanel}}"
    class="sheet-mask {{morePanelDragging ? 'is-dragging' : ''}} {{morePanelClosing ? 'is-closing' : ''}}"
    style="opacity: {{morePanelMaskOpacity}};"
    bindtap="closeMorePanel"
    catchtouchmove="noopTouchMove"
  ></view>
  <view
    wx:if="{{showMorePanel}}"
    class="more-sheet {{morePanelDragging ? 'is-dragging' : ''}} {{morePanelClosing ? 'is-closing' : ''}}"
    style="transform: translate3d(0, {{morePanelTranslateY}}px, 0);"
    bindtouchstart="onMorePanelTouchStart"
    catchtouchmove="onMorePanelTouchMove"
    bindtouchend="onMorePanelTouchEnd"
    bindtouchcancel="resetMorePanelTouch"
  >
    <view class="sheet-handle"></view>
    <text class="sheet-title">{{cocktail.name}}</text>

    <block wx:if="{{cocktail.source === 'custom'}}">
      <button class="sheet-action" bindtap="navigateToEdit">编辑酒谱</button>
      <button class="sheet-action" bindtap="navigateToExport">分享酒谱</button>
      <button class="sheet-action danger" bindtap="confirmDelete">删除私藏酒谱</button>
    </block>

    <view wx:else class="sheet-empty">
      <text class="sheet-empty-title">馆藏酒谱</text>
      <text class="sheet-empty-copy">馆藏酒谱暂不支持编辑、删除或分享。</text>
    </view>

    <button class="sheet-cancel" bindtap="closeMorePanel">取消</button>
  </view>
</view>

<view class="container detail-page error-page" wx:else>
  <view class="detail-section">
    <text class="section-kicker">ERROR</text>
    <text class="section-title">酒谱不可用</text>
    <text class="section-body">{{error || '请返回首页重新选择酒谱'}}</text>
  </view>
</view>
