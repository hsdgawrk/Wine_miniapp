.detail-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 286rpx;
  box-sizing: border-box;
  background:
    linear-gradient(135deg, rgba(215, 255, 104, 0.07), transparent 30%),
    linear-gradient(180deg, #171512 0%, #11100e 56%, #1b1813 100%);
}

.detail-hero {
  position: relative;
  min-height: 440rpx;
  padding: 34rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  overflow: hidden;
  background:
    linear-gradient(135deg, rgba(255, 184, 77, 0.28), transparent 42%),
    linear-gradient(145deg, rgba(42, 39, 32, 0.97), rgba(19, 18, 15, 0.95));
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  box-shadow: 0 28rpx 80rpx rgba(0, 0, 0, 0.34);
}

.detail-hero::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 8rpx;
  background: linear-gradient(90deg, #d7ff68, #ffb84d, #fff8ee);
}

.detail-hero::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background:
    linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1rpx, transparent 1rpx),
    linear-gradient(180deg, rgba(255, 255, 255, 0.04) 1rpx, transparent 1rpx);
  background-size: 46rpx 46rpx;
  opacity: 0.28;
  pointer-events: none;
}

.hero-copy {
  position: relative;
  z-index: 1;
  padding-right: 96rpx;
}

.hero-eyebrow {
  display: inline-flex;
  max-width: 320rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #15130f;
  background: #d7ff68;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cocktail-name {
  display: block;
  margin: 26rpx 0 18rpx;
  color: #fff8ee;
  font-size: 62rpx;
  font-weight: 900;
  line-height: 1.06;
}

.cocktail-desc {
  display: -webkit-box;
  color: rgba(247, 241, 232, 0.76);
  font-size: 28rpx;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.hero-mark {
  position: absolute;
  right: 22rpx;
  bottom: 28rpx;
  z-index: 1;
  width: 210rpx;
  height: 210rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.hero-emoji {
  font-size: 118rpx;
  line-height: 1;
}

.quick-meta {
  display: flex;
  align-items: stretch;
  margin: 18rpx 0;
}

.meta-cell {
  flex: 1;
  min-height: 112rpx;
  padding: 20rpx 18rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.meta-cell + .meta-cell {
  margin-left: 12rpx;
}

.meta-label {
  display: block;
  color: rgba(247, 241, 232, 0.44);
  font-size: 21rpx;
  font-weight: 800;
  margin-bottom: 10rpx;
}

.meta-value {
  display: block;
  color: #fff8ee;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.2;
}

.detail-section {
  margin-top: 16rpx;
  padding: 30rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.075);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 16rpx 46rpx rgba(0, 0, 0, 0.18);
}

.section-kicker {
  display: block;
  color: #d7ff68;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
  margin-bottom: 14rpx;
}

.section-title {
  display: block;
  color: #fff8ee;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.2;
  margin-bottom: 18rpx;
}

.section-body {
  display: block;
  color: rgba(247, 241, 232, 0.72);
  font-size: 28rpx;
  line-height: 1.72;
}

.ingredient-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx -10rpx 0;
}

.ingredient-chip {
  margin: 0 10rpx 10rpx 0;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  color: #fff8ee;
  background: rgba(255, 255, 255, 0.09);
  border: 1rpx solid rgba(255, 255, 255, 0.11);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.1;
}

.action-dock {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 18rpx 30rpx;
  box-sizing: border-box;
  border-radius: 18rpx 18rpx 0 0;
  background:
    linear-gradient(135deg, rgba(255, 248, 238, 0.12), rgba(255, 248, 238, 0.04)),
    rgba(18, 17, 15, 0.94);
  backdrop-filter: blur(24rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-bottom: 0;
  box-shadow: 0 -18rpx 54rpx rgba(0, 0, 0, 0.28);
  z-index: 10;
}

.primary-button,
.secondary-button {
  width: 100%;
  flex: none;
  height: 88rpx;
  line-height: 88rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.primary-button::after,
.secondary-button::after {
  border: 0;
}

.primary-button {
  background: #d7ff68;
  color: #15130f;
  box-shadow: 0 18rpx 42rpx rgba(215, 255, 104, 0.18);
}

.secondary-button {
  height: 76rpx;
  line-height: 76rpx;
  margin-top: 18rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #fff8ee;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  font-size: 26rpx;
}

.primary-button:active,
.secondary-button:active {
  transform: scale(0.98);
}

.error-page {
  padding-top: 88rpx;
}

@media (max-width: 750rpx) {
  .detail-page {
    padding-left: 20rpx;
    padding-right: 20rpx;
  }

  .detail-hero {
    min-height: 410rpx;
    padding: 30rpx;
  }

  .cocktail-name {
    font-size: 54rpx;
  }

  .hero-mark {
    width: 176rpx;
    height: 176rpx;
  }

  .hero-emoji {
    font-size: 100rpx;
  }

  .action-dock {
    left: 20rpx;
    right: 20rpx;
  }

  .secondary-button {
    height: 74rpx;
    line-height: 74rpx;
  }
}
