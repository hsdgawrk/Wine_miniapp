page {
  min-height: 100%;
  background: #12110f;
  background-color: #12110f;
}

.edit-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 40rpx;
  box-sizing: border-box;
  background:
    linear-gradient(135deg, rgba(215, 255, 104, 0.07), transparent 30%),
    linear-gradient(180deg, #171512 0%, #11100e 56%, #1b1813 100%);
}

.form-header {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  overflow: hidden;
  padding: 34rpx 30rpx;
  border-radius: 16rpx;
  background:
    linear-gradient(135deg, rgba(215, 255, 104, 0.14), transparent 48%),
    rgba(255, 255, 255, 0.075);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 20rpx 58rpx rgba(0, 0, 0, 0.22);
}

.eyebrow {
  display: block;
  color: #d7ff68;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1;
  margin-bottom: 14rpx;
}

.form-title {
  display: block;
  color: #fff8ee;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.1;
  margin-bottom: 14rpx;
}

.form-subtitle {
  display: block;
  color: rgba(247, 241, 232, 0.62);
  font-size: 26rpx;
  line-height: 1.5;
}

.header-symbol {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  background: #d7ff68;
  color: #15130f;
  font-size: 48rpx;
  font-weight: 900;
  text-align: center;
  margin-left: 20rpx;
}

.warning-panel,
.form-section {
  margin-top: 18rpx;
  padding: 30rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.075);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 16rpx 46rpx rgba(0, 0, 0, 0.18);
}

.warning-panel {
  border-color: rgba(255, 184, 77, 0.34);
  background: rgba(255, 184, 77, 0.1);
}

.warning-title {
  display: block;
  color: #ffb84d;
  font-size: 28rpx;
  font-weight: 900;
}

.warning-copy {
  display: block;
  margin-top: 10rpx;
  color: rgba(247, 241, 232, 0.72);
  font-size: 25rpx;
  line-height: 1.48;
}

.form-group {
  margin-bottom: 32rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-grid {
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.form-grid:last-child {
  margin-bottom: 0;
}

.form-grid-item {
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
}

.form-grid-item + .form-grid-item {
  margin-left: 16rpx;
}

.form-label,
.form-section-title {
  display: block;
  color: #fff8ee;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.2;
  margin-bottom: 18rpx;
}

.form-section-title {
  font-size: 32rpx;
  margin-bottom: 0;
}

.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 26rpx;
}

.section-mini-label {
  color: rgba(247, 241, 232, 0.42);
  font-size: 20rpx;
  font-weight: 900;
}

.form-input,
.ingredient-input {
  width: 100%;
  min-height: 92rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.08);
  color: #fff8ee;
  font-size: 28rpx;
}

.form-input.error,
.time-picker-row.error {
  border-color: rgba(255, 122, 102, 0.82);
  background: rgba(255, 122, 102, 0.08);
}

.form-textarea {
  min-height: 144rpx;
  line-height: 1.6;
}

.placeholder {
  color: rgba(247, 241, 232, 0.34);
}

.picker-display,
.time-picker-row {
  min-height: 92rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
}

.picker-text {
  flex: 1;
  min-width: 0;
  color: #fff8ee;
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-arrow {
  color: rgba(215, 255, 104, 0.72);
  font-size: 36rpx;
  font-weight: 900;
}

.picker-emoji {
  font-size: 40rpx;
  line-height: 1;
  margin-right: 16rpx;
}

.time-picker-row {
  padding: 0 10rpx;
}

.time-picker {
  flex: 1;
  min-width: 0;
}

.time-picker + .time-picker {
  margin-left: 10rpx;
}

.time-picker-display {
  height: 70rpx;
  line-height: 70rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  color: #fff8ee;
  background: rgba(255, 255, 255, 0.07);
  font-size: 27rpx;
  font-weight: 800;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ingredient-input-group {
  display: flex;
  align-items: stretch;
  margin-bottom: 24rpx;
}

.ingredient-input {
  flex: 1;
  min-width: 0;
}

.add-ingredient-btn {
  flex: 0 0 118rpx;
  width: 118rpx;
  margin: 0 0 0 18rpx;
  min-height: 92rpx;
  line-height: 92rpx;
  padding: 0;
  border-radius: 14rpx;
  background: #d7ff68;
  color: #15130f;
  font-size: 27rpx;
  font-weight: 900;
}

.ingredients-list {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx -10rpx 0;
}

.ingredient-item {
  display: flex;
  align-items: center;
  max-width: 100%;
  margin: 0 10rpx 10rpx 0;
  padding: 10rpx 10rpx 10rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.11);
}

.ingredient-name {
  max-width: 460rpx;
  color: rgba(247, 241, 232, 0.82);
  font-size: 25rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.remove-ingredient-btn {
  width: 44rpx !important;
  height: 44rpx !important;
  min-height: 44rpx !important;
  line-height: 44rpx !important;
  padding: 0 !important;
  margin-left: 10rpx;
  border-radius: 50%;
  background: rgba(255, 122, 102, 0.14);
  color: #ff7a66;
  font-size: 28rpx;
  font-weight: 900;
}

.step-form-group {
  margin-bottom: 28rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.step-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.step-number {
  color: #d7ff68;
  font-size: 26rpx;
  font-weight: 900;
}

.step-tools {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  max-width: 390rpx;
  margin: -8rpx -8rpx 0 18rpx;
}

.step-tool-btn {
  width: 76rpx !important;
  height: 48rpx !important;
  min-height: 48rpx !important;
  line-height: 48rpx !important;
  padding: 0 !important;
  margin: 8rpx 8rpx 0 0;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.08);
  color: rgba(247, 241, 232, 0.82);
  font-size: 22rpx;
  font-weight: 900;
}

.step-tool-btn.danger {
  color: #ff7a66;
  background: rgba(255, 122, 102, 0.12);
}

.step-input {
  background: rgba(255, 255, 255, 0.07);
}

.add-step-button {
  height: 82rpx;
  line-height: 82rpx;
  padding: 0;
  border-radius: 14rpx;
  border: 1rpx solid rgba(215, 255, 104, 0.42);
  background: rgba(215, 255, 104, 0.1);
  color: #d7ff68;
  font-size: 27rpx;
  font-weight: 900;
}

.action-buttons {
  display: flex;
  justify-content: center;
  margin-top: 20rpx;
}

.cancel-button,
.save-button,
.primary-button {
  flex: 0 1 300rpx;
  width: 300rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin: 0;
  padding: 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.cancel-button {
  background: rgba(255, 255, 255, 0.09);
  color: rgba(247, 241, 232, 0.82);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
}

.save-button,
.primary-button {
  margin-left: 18rpx;
  background: #d7ff68;
  color: #15130f;
  box-shadow: 0 18rpx 42rpx rgba(215, 255, 104, 0.18);
}

.primary-button {
  width: 280rpx;
  margin: 28rpx auto 0;
}

.error-message {
  display: block;
  color: #ff7a66;
  font-size: 24rpx;
  line-height: 1.4;
  margin-top: 12rpx;
}

.error-state {
  margin-top: 88rpx;
  padding: 42rpx 30rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.075);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  text-align: center;
}

.error-kicker {
  display: block;
  color: #ff7a66;
  font-size: 20rpx;
  font-weight: 900;
}

.error-title {
  display: block;
  margin-top: 16rpx;
  color: #fff8ee;
  font-size: 34rpx;
  font-weight: 900;
}

.error-copy {
  display: block;
  margin-top: 14rpx;
  color: rgba(247, 241, 232, 0.62);
  font-size: 26rpx;
  line-height: 1.5;
}

@media (max-width: 750rpx) {
  .edit-page {
    padding-left: 20rpx;
    padding-right: 20rpx;
  }

  .form-header,
  .form-section {
    padding-left: 26rpx;
    padding-right: 26rpx;
  }

  .step-header {
    align-items: flex-start;
  }

  .step-tools {
    max-width: 300rpx;
  }
}
