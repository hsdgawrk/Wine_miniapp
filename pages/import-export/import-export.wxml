<view class="container transfer-page">
  <view class="page-header">
    <text class="eyebrow">{{modeEyebrow}}</text>
    <text class="page-title">{{modeTitle}}</text>
    <text class="page-subtitle">{{modeSubtitle}}</text>
  </view>

  <view wx:if="{{errorMessage}}" class="error-panel">
    <text class="error-code">{{errorCode}}</text>
    <text class="error-message">{{errorMessage}}</text>
    <button
      wx:if="{{showEditExportAction}}"
      class="primary-button single"
      bindtap="navigateToEdit"
    >去编辑</button>
  </view>

  <block wx:if="{{isExport}}">
    <view class="export-card" wx:if="{{cocktail}}">
      <view class="cocktail-line">
        <text class="cocktail-emoji">{{cocktail.emoji || '🍸'}}</text>
        <view class="cocktail-copy">
          <text class="cocktail-name">{{cocktail.name}}</text>
          <text class="cocktail-meta">{{cocktail.category}} · {{cocktail.difficulty}} · {{cocktail.time}}</text>
        </view>
      </view>
    </view>

    <view class="code-section" wx:if="{{importCode}}">
      <view class="section-title-row">
        <text class="section-title">配方导入码</text>
        <text class="section-count">V1</text>
      </view>
      <scroll-view class="code-box" scroll-y="true">
        <text class="code-text">{{importCode}}</text>
      </scroll-view>
      <button class="primary-button" bindtap="copyImportCode">复制导入码</button>
    </view>
  </block>

  <block wx:else>
    <view class="form-section">
      <text class="section-title">粘贴导入码</text>
      <textarea
        class="import-textarea"
        value="{{importText}}"
        bindinput="onInputImportText"
        placeholder="COCKTAIL_V1:..."
        placeholder-class="placeholder"
        maxlength="20000"
      />
      <view class="import-actions">
        <button class="secondary-button" loading="{{isReadingClipboard}}" disabled="{{isReadingClipboard}}" bindtap="readClipboard">从剪贴板读取</button>
        <button class="primary-button" bindtap="validateImportText">校验导入码</button>
      </view>
    </view>

    <view class="preview-section" wx:if="{{importPreview}}">
      <view class="section-title-row">
        <text class="section-title">导入预览</text>
        <text class="section-count">确认后保存</text>
      </view>

      <view class="form-group">
        <text class="form-label">导入后名称</text>
        <input
          class="target-input"
          value="{{targetName}}"
          bindinput="onInputTargetName"
          maxlength="20"
          placeholder="请输入导入后名称"
          placeholder-class="placeholder"
        />
      </view>

      <view class="preview-grid">
        <view class="preview-cell">
          <text class="preview-label">分类</text>
          <text class="preview-value">{{importPreview.fields.category}}</text>
        </view>
        <view class="preview-cell">
          <text class="preview-label">难度</text>
          <text class="preview-value">{{importPreview.fields.difficulty}}</text>
        </view>
        <view class="preview-cell">
          <text class="preview-label">制作时间</text>
          <text class="preview-value">{{importPreview.fields.time}}</text>
        </view>
      </view>

      <view class="readonly-block">
        <text class="preview-label">简介</text>
        <text class="readonly-text">{{importPreview.fields.description}}</text>
      </view>

      <view class="readonly-block">
        <text class="preview-label">成分</text>
        <view class="chip-list">
          <text class="chip" wx:for="{{importPreview.fields.ingredients}}" wx:key="index">{{item}}</text>
        </view>
      </view>

      <view class="readonly-block">
        <text class="preview-label">制作步骤</text>
        <view class="step-preview" wx:for="{{importPreview.fields.steps}}" wx:key="index">
          <text class="step-number">步骤 {{item.number}}</text>
          <text class="step-text">{{item.instruction}}</text>
        </view>
      </view>

      <button class="primary-button" loading="{{isConfirming}}" disabled="{{isConfirming}}" bindtap="confirmImport">确认导入</button>
    </view>
  </block>
</view>
