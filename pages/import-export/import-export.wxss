page {
  min-height: 100%;
  background: #12110f;
  background-color: #12110f;
}

.transfer-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 40rpx;
  box-sizing: border-box;
  background:
    linear-gradient(135deg, rgba(215, 255, 104, 0.07), transparent 30%),
    linear-gradient(180deg, #171512 0%, #11100e 56%, #1b1813 100%);
}

.page-header,
.form-section,
.preview-section,
.code-section,
.export-card,
.error-panel {
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.075);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 16rpx 46rpx rgba(0, 0, 0, 0.18);
}

.page-header {
  padding: 34rpx 30rpx;
  background:
    linear-gradient(135deg, rgba(215, 255, 104, 0.14), transparent 48%),
    rgba(255, 255, 255, 0.075);
}

.eyebrow {
  display: block;
  color: #d7ff68;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
  margin-bottom: 14rpx;
}

.page-title {
  display: block;
  color: #fff8ee;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.1;
}

.page-subtitle {
  display: block;
  margin-top: 16rpx;
  color: rgba(247, 241, 232, 0.62);
  font-size: 26rpx;
  line-height: 1.5;
}

.error-panel {
  margin-top: 18rpx;
  padding: 26rpx;
  border-color: rgba(255, 122, 102, 0.28);
  background: rgba(255, 122, 102, 0.08);
}

.error-code {
  display: block;
  color: #ff7a66;
  font-size: 20rpx;
  font-weight: 900;
}

.error-message {
  display: block;
  margin-top: 12rpx;
  color: #fff8ee;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.45;
}

.export-card,
.form-section,
.preview-section,
.code-section {
  margin-top: 18rpx;
  padding: 30rpx;
}

.cocktail-line {
  display: flex;
  align-items: center;
}

.cocktail-emoji {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  background: #d7ff68;
  color: #15130f;
  text-align: center;
  font-size: 46rpx;
}

.cocktail-copy {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.cocktail-name {
  display: block;
  color: #fff8ee;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.2;
}

.cocktail-meta {
  display: block;
  margin-top: 10rpx;
  color: rgba(247, 241, 232, 0.58);
  font-size: 24rpx;
  line-height: 1.35;
}

.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.section-title {
  display: block;
  color: #fff8ee;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.2;
}

.section-count {
  color: rgba(247, 241, 232, 0.42);
  font-size: 20rpx;
  font-weight: 900;
}

.code-box {
  height: 280rpx;
  max-height: 30vh;
  padding: 22rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: rgba(0, 0, 0, 0.24);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.code-text {
  display: block;
  color: rgba(247, 241, 232, 0.82);
  font-size: 23rpx;
  line-height: 1.55;
  word-break: break-all;
}

.import-textarea {
  width: 100%;
  min-height: 230rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.08);
  color: #fff8ee;
  font-size: 26rpx;
  line-height: 1.55;
}

.placeholder {
  color: rgba(247, 241, 232, 0.34);
}

.import-actions {
  display: flex;
  justify-content: center;
  margin-top: 18rpx;
}

.primary-button,
.secondary-button {
  flex: 0 1 300rpx;
  width: 300rpx;
  height: 86rpx;
  line-height: 86rpx;
  padding: 0;
  margin: 0;
  border-radius: 14rpx;
  font-size: 27rpx;
  font-weight: 900;
}

.primary-button {
  background: #d7ff68;
  color: #15130f;
  box-shadow: 0 18rpx 42rpx rgba(215, 255, 104, 0.18);
}

.secondary-button {
  background: rgba(255, 255, 255, 0.09);
  color: #fff8ee;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
}

.import-actions .primary-button {
  margin-left: 18rpx;
}

.primary-button.single {
  width: 260rpx;
  flex: none;
  margin-top: 20rpx;
}

.code-section .primary-button,
.preview-section .primary-button {
  margin-top: 22rpx;
  width: 100%;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label,
.preview-label {
  display: block;
  color: rgba(247, 241, 232, 0.56);
  font-size: 23rpx;
  font-weight: 900;
  margin-bottom: 12rpx;
}

.target-input {
  width: 100%;
  min-height: 88rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.08);
  color: #fff8ee;
  font-size: 28rpx;
}

.preview-grid {
  display: flex;
  margin: 0 -10rpx 18rpx 0;
}

.preview-cell {
  flex: 1;
  min-width: 0;
  margin-right: 10rpx;
  padding: 18rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.preview-value {
  display: block;
  color: #fff8ee;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.24;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.readonly-block {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.readonly-text {
  display: block;
  color: rgba(247, 241, 232, 0.76);
  font-size: 26rpx;
  line-height: 1.58;
}

.chip-list {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx -10rpx 0;
}

.chip {
  margin: 0 10rpx 10rpx 0;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  color: #fff8ee;
  background: rgba(255, 255, 255, 0.09);
  border: 1rpx solid rgba(255, 255, 255, 0.11);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.1;
}

.step-preview {
  margin-top: 12rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.step-number {
  display: block;
  color: #d7ff68;
  font-size: 22rpx;
  font-weight: 900;
  margin-bottom: 10rpx;
}

.step-text {
  display: block;
  color: rgba(247, 241, 232, 0.76);
  font-size: 25rpx;
  line-height: 1.55;
}

.step-detail-list {
  margin-top: 12rpx;
}

.step-detail {
  display: block;
  color: rgba(215, 255, 104, 0.76);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.45;
  margin-top: 6rpx;
}

@media (max-width: 750rpx) {
  .transfer-page {
    padding-left: 20rpx;
    padding-right: 20rpx;
  }

  .page-header,
  .form-section,
  .preview-section,
  .code-section,
  .export-card {
    padding-left: 26rpx;
    padding-right: 26rpx;
  }

  .preview-grid {
    display: block;
    margin-right: 0;
  }

  .preview-cell {
    margin: 0 0 10rpx;
  }
}
