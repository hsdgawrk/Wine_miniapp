<view class="container custom-page">
  <view class="page-header">
    <view>
      <text class="eyebrow">CUSTOM CELLAR</text>
      <text class="page-title">私藏酒谱</text>
      <text class="page-subtitle">管理这台设备上的私藏酒谱</text>
    </view>
    <view class="header-actions">
      <button class="add-header-button" bindtap="navigateToAdd">添加</button>
      <button
        class="manage-button {{isManaging ? 'active' : ''}} {{customCocktails.length === 0 ? 'disabled' : ''}}"
        disabled="{{customCocktails.length === 0}}"
        bindtap="toggleManageMode"
      >
        {{manageButtonText}}
      </button>
    </view>
  </view>

  <view class="toolbar">
    <view class="search-bar">
      <text class="search-glyph">⌕</text>
      <input
        class="search-input"
        value="{{searchQuery}}"
        bindinput="onSearch"
        placeholder="搜索酒名、风味、分类、难度或材料"
        placeholder-class="placeholder"
        confirm-type="search"
      />
      <view wx:if="{{searchQuery}}" class="clear-search" bindtap="clearSearch">
        <text class="clear-icon">×</text>
      </view>
    </view>

    <picker bindchange="onSortChange" value="{{sortIndex}}" range="{{sortOptions}}">
      <view class="sort-button">
        <text>{{sortLabel}}</text>
        <text class="sort-arrow">›</text>
      </view>
    </picker>
  </view>

  <view wx:if="{{isManaging && visibleCocktails.length}}" class="manage-strip">
    <view class="select-all" bindtap="toggleSelectAllVisible">
      <view class="check-box {{allVisibleSelected ? 'checked' : ''}}"></view>
      <text>{{allVisibleSelected ? '取消全选' : '全选可见'}}</text>
    </view>
    <text class="selected-count">已选 {{selectedCount}}</text>
  </view>

  <view wx:if="{{customCocktails.length === 0}}" class="empty-state">
    <text class="empty-mark">＋</text>
    <text class="empty-title">还没有私藏酒谱</text>
    <text class="empty-copy">可以记一杯新酒，也可以粘贴酒谱文本收录到私藏。</text>
    <view class="empty-actions">
      <button class="primary-button" bindtap="navigateToAdd">记一杯新酒</button>
      <button class="secondary-button" bindtap="navigateToImport">收录酒谱</button>
    </view>
  </view>

  <view wx:elif="{{visibleCocktails.length === 0}}" class="empty-state">
    <text class="empty-mark">⌕</text>
    <text class="empty-title">未找到私藏酒谱</text>
    <text class="empty-copy">换一个关键词，或清除搜索后查看全部私藏酒谱。</text>
    <button class="primary-button single" bindtap="clearSearch">清除搜索</button>
  </view>

  <view wx:else class="custom-list {{isManaging ? 'manage-mode' : ''}}">
    <view
      wx:for="{{visibleCocktails}}"
      wx:key="id"
      class="custom-card {{item.isSelected ? 'selected' : ''}}"
      data-id="{{item.id}}"
      bindtap="onItemTap"
    >
      <view wx:if="{{isManaging}}" class="check-box {{item.isSelected ? 'checked' : ''}}"></view>

      <view class="card-symbol">
        <text class="card-emoji">{{item.emoji || '🍸'}}</text>
      </view>

      <view class="card-content">
        <view class="card-title-row">
          <text class="card-name">{{item.name}}</text>
          <text class="card-category">{{item.category}}</text>
        </view>
        <text class="card-desc">{{item.description}}</text>
        <view class="card-meta">
          <text>{{item.difficulty}}</text>
          <text>{{item.time}}</text>
          <text>{{item.ingredientCount}} 种材料</text>
        </view>
        <view class="card-footer">
          <text class="updated-text">最近保存 {{item.updatedAtText}}</text>
          <text wx:if="{{item.ingredientsPreview}}" class="preview-text">{{item.ingredientsPreview}}</text>
        </view>
      </view>

      <view
        wx:if="{{!isManaging}}"
        class="more-button"
        data-id="{{item.id}}"
        catchtap="openMorePanel"
      >
        <text>•••</text>
      </view>
    </view>
  </view>

  <view wx:if="{{isManaging && visibleCocktails.length}}" class="batch-dock">
    <text class="batch-text">已选 {{selectedCount}} 条</text>
    <button class="batch-delete" bindtap="confirmBatchDelete">删除所选</button>
  </view>

  <view wx:if="{{showMorePanel}}" class="sheet-mask" bindtap="closeMorePanel" catchtouchmove="noopTouchMove"></view>
  <view wx:if="{{showMorePanel}}" class="more-sheet" catchtouchmove="noopTouchMove">
    <view class="sheet-handle"></view>
    <text class="sheet-title">{{activeCocktail.name}}</text>
    <button class="sheet-action" bindtap="editActiveCocktail">编辑酒谱</button>
    <button class="sheet-action danger" bindtap="deleteActiveCocktail">删除酒谱</button>
    <button class="sheet-cancel" bindtap="closeMorePanel">取消</button>
  </view>
</view>
