page {
  min-height: 100%;
  background: #12110f;
  background-color: #12110f;
}

.custom-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 40rpx;
  box-sizing: border-box;
  background:
    linear-gradient(135deg, rgba(215, 255, 104, 0.07), transparent 30%),
    linear-gradient(180deg, #171512 0%, #11100e 56%, #1b1813 100%);
}

.page-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 34rpx 30rpx;
  border-radius: 16rpx;
  background:
    linear-gradient(135deg, rgba(255, 184, 77, 0.16), transparent 46%),
    rgba(255, 255, 255, 0.075);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 20rpx 58rpx rgba(0, 0, 0, 0.22);
}

.eyebrow {
  display: block;
  color: #d7ff68;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
  margin-bottom: 14rpx;
}

.page-title {
  display: block;
  color: #fff8ee;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.1;
}

.page-subtitle {
  display: block;
  margin-top: 14rpx;
  color: rgba(247, 241, 232, 0.62);
  font-size: 25rpx;
  line-height: 1.5;
}

.manage-button {
  flex-shrink: 0;
  width: 118rpx;
  height: 70rpx;
  line-height: 70rpx;
  margin: 0;
  padding: 0;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.1);
  color: #fff8ee;
  font-size: 26rpx;
  font-weight: 900;
}

.manage-button.active {
  background: #d7ff68;
  color: #15130f;
}

.header-actions {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
}

.add-header-button {
  width: 118rpx;
  height: 70rpx;
  line-height: 70rpx;
  margin: 0 0 12rpx;
  padding: 0;
  border-radius: 14rpx;
  background: #d7ff68;
  color: #15130f;
  font-size: 26rpx;
  font-weight: 900;
}

.toolbar {
  display: flex;
  align-items: stretch;
  margin-top: 18rpx;
}

.search-bar {
  flex: 1;
  min-height: 92rpx;
  padding: 0 16rpx 0 22rpx;
  display: flex;
  align-items: center;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.09);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
}

.search-glyph {
  width: 42rpx;
  color: #d7ff68;
  font-size: 32rpx;
  font-weight: 900;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 92rpx;
  padding: 0 10rpx;
  box-sizing: border-box;
  color: #fff8ee;
  font-size: 27rpx;
}

.placeholder {
  color: rgba(247, 241, 232, 0.34);
}

.clear-search {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.clear-icon {
  color: rgba(247, 241, 232, 0.8);
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1;
}

.sort-button {
  width: 176rpx;
  height: 92rpx;
  margin-left: 12rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.09);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  color: #fff8ee;
  font-size: 25rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sort-arrow {
  color: #d7ff68;
  font-size: 34rpx;
  line-height: 1;
}

.manage-strip {
  min-height: 72rpx;
  margin-top: 16rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background: rgba(215, 255, 104, 0.09);
  border: 1rpx solid rgba(215, 255, 104, 0.18);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.select-all {
  display: flex;
  align-items: center;
  color: #d7ff68;
  font-size: 25rpx;
  font-weight: 900;
}

.check-box {
  flex-shrink: 0;
  width: 38rpx;
  height: 38rpx;
  margin-right: 12rpx;
  border-radius: 10rpx;
  border: 2rpx solid rgba(247, 241, 232, 0.46);
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.06);
}

.check-box.checked {
  border-color: #d7ff68;
  background: #d7ff68;
  box-shadow: inset 0 0 0 8rpx #15130f;
}

.selected-count {
  color: rgba(247, 241, 232, 0.68);
  font-size: 24rpx;
  font-weight: 800;
}

.empty-state {
  margin-top: 18rpx;
  padding: 70rpx 34rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.075);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  text-align: center;
}

.empty-mark {
  display: block;
  color: #d7ff68;
  font-size: 72rpx;
  font-weight: 900;
  line-height: 1;
  margin-bottom: 24rpx;
}

.empty-title {
  display: block;
  color: #fff8ee;
  font-size: 34rpx;
  font-weight: 900;
}

.empty-copy {
  display: block;
  margin-top: 14rpx;
  color: rgba(247, 241, 232, 0.62);
  font-size: 26rpx;
  line-height: 1.5;
}

.empty-actions {
  display: flex;
  margin-top: 34rpx;
}

.primary-button,
.secondary-button {
  flex: 1;
  height: 82rpx;
  line-height: 82rpx;
  padding: 0;
  border-radius: 14rpx;
  font-size: 27rpx;
  font-weight: 900;
}

.primary-button {
  background: #d7ff68;
  color: #15130f;
}

.secondary-button {
  margin-left: 14rpx;
  background: rgba(255, 255, 255, 0.09);
  color: #fff8ee;
}

.primary-button.single {
  width: 280rpx;
  flex: none;
  margin-top: 32rpx;
}

.custom-list {
  margin-top: 18rpx;
}

.custom-list.manage-mode {
  padding-bottom: 144rpx;
}

.custom-card {
  position: relative;
  display: flex;
  align-items: stretch;
  min-height: 212rpx;
  margin-bottom: 16rpx;
  padding: 20rpx 18rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.075);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 16rpx 46rpx rgba(0, 0, 0, 0.18);
}

.custom-card.selected {
  border-color: rgba(215, 255, 104, 0.5);
  background: rgba(215, 255, 104, 0.08);
}

.custom-card > .check-box {
  margin: 54rpx 14rpx 0 0;
}

.card-symbol {
  flex-shrink: 0;
  width: 84rpx;
  height: 84rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.09);
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-emoji {
  font-size: 44rpx;
  line-height: 1;
}

.card-content {
  flex: 1;
  min-width: 0;
  padding: 0 14rpx 0 18rpx;
}

.card-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.card-name {
  flex: 1;
  min-width: 0;
  color: #fff8ee;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.2;
  margin-right: 12rpx;
}

.card-category {
  flex-shrink: 0;
  max-width: 128rpx;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  color: #15130f;
  background: #fff8ee;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-desc {
  display: -webkit-box;
  color: rgba(247, 241, 232, 0.64);
  font-size: 24rpx;
  line-height: 1.44;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.card-meta {
  display: flex;
  flex-wrap: wrap;
  margin: 14rpx -8rpx 0 0;
}

.card-meta text {
  margin: 0 8rpx 8rpx 0;
  padding: 7rpx 11rpx;
  border-radius: 10rpx;
  color: rgba(247, 241, 232, 0.76);
  background: rgba(255, 255, 255, 0.08);
  font-size: 21rpx;
  font-weight: 700;
}

.card-footer {
  margin-top: 8rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.09);
}

.updated-text,
.preview-text {
  display: block;
  color: rgba(247, 241, 232, 0.45);
  font-size: 21rpx;
  line-height: 1.35;
}

.preview-text {
  margin-top: 4rpx;
  color: rgba(247, 241, 232, 0.62);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.more-button {
  flex-shrink: 0;
  width: 58rpx;
  height: 58rpx;
  border-radius: 14rpx;
  color: #d7ff68;
  background: rgba(215, 255, 104, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 900;
}

.batch-dock {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  z-index: 20;
  height: 104rpx;
  padding: 14rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background:
    linear-gradient(135deg, rgba(255, 248, 238, 0.12), rgba(255, 248, 238, 0.04)),
    rgba(18, 17, 15, 0.96);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -18rpx 54rpx rgba(0, 0, 0, 0.3);
}

.batch-text {
  color: #fff8ee;
  font-size: 27rpx;
  font-weight: 900;
  padding-left: 16rpx;
}

.batch-delete {
  width: 220rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0;
  margin: 0;
  border-radius: 14rpx;
  background: rgba(255, 122, 102, 0.16);
  color: #ff7a66;
  font-size: 27rpx;
  font-weight: 900;
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 40;
  background: rgba(0, 0, 0, 0.56);
}

.more-sheet {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  z-index: 41;
  padding: 18rpx 18rpx 24rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background:
    linear-gradient(135deg, rgba(215, 255, 104, 0.08), transparent 48%),
    #1d1a16;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  box-shadow: 0 -24rpx 80rpx rgba(0, 0, 0, 0.44);
}

.sheet-handle {
  width: 82rpx;
  height: 8rpx;
  margin: 0 auto 24rpx;
  border-radius: 999rpx;
  background: rgba(247, 241, 232, 0.22);
}

.sheet-title {
  display: block;
  color: #fff8ee;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.2;
  margin: 0 10rpx 18rpx;
}

.sheet-action,
.sheet-cancel {
  width: 100%;
  height: 86rpx;
  line-height: 86rpx;
  margin: 0 0 12rpx;
  padding: 0;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #fff8ee;
  font-size: 27rpx;
  font-weight: 900;
}

.sheet-action.danger {
  color: #ff7a66;
  background: rgba(255, 122, 102, 0.12);
}

.sheet-cancel {
  margin-bottom: 0;
  background: #d7ff68;
  color: #15130f;
}

@media (max-width: 750rpx) {
  .custom-page {
    padding-left: 20rpx;
    padding-right: 20rpx;
  }

  .page-header {
    padding-left: 26rpx;
    padding-right: 26rpx;
  }

  .sort-button {
    width: 160rpx;
  }

  .card-category {
    max-width: 116rpx;
  }
}
