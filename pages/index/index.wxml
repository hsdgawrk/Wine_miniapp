<view class="container index-page">
  <view wx:if="{{isLoading}}" class="loading">
    <loading class="loading-spinner" type="dot-gray" />
    <text class="loading-text">加载中...</text>
  </view>

  <view wx:elif="{{error}}" class="error-container">
    <text class="error-text">{{error.message}}</text>
    <text class="error-context">操作：{{error.context}}</text>
    <button class="retry-btn" bindtap="retryOperation">重试</button>
  </view>

  <block wx:else>
    <view wx:if="{{activeMainTab === 'home'}}" class="main-tab-panel {{mainTabTransitionClass}}">
      <view class="home-atmosphere" aria-hidden="true">
        <view class="home-ribbon home-ribbon-lime"></view>
        <view class="home-ribbon home-ribbon-amber"></view>
        <view class="home-caustic"></view>
      </view>

      <view class="top-strip">
        <view>
          <text class="eyebrow">BAR INDEX</text>
          <text class="page-title">今晚喝什么</text>
        </view>
        <view class="library-stat">
          <text class="library-stat-value">{{totalCount}}</text>
          <text class="library-stat-label">配方</text>
        </view>
      </view>

      <view
        wx:if="{{randomCocktail}}"
        class="daily-cocktail-card slide-up"
        bindtap="onDailyRecommendTap"
      >
        <view class="daily-card-aura" aria-hidden="true"></view>

        <view class="date-plate">
          <text class="date-month">{{currentDate.month}}</text>
          <text class="date-day">{{currentDate.day}}</text>
          <text class="date-weekday">{{currentDate.weekday}}</text>
        </view>

        <view class="daily-content">
          <view class="daily-kicker">
            <text class="daily-label">今日特调</text>
            <text class="daily-year">{{currentDate.year}}</text>
          </view>
          <text class="daily-cocktail-title">{{randomCocktail.name}}</text>
          <text class="daily-cocktail-description">{{randomCocktail.description}}</text>

          <view class="daily-meta">
            <text wx:if="{{randomCocktail.difficulty}}" class="meta-item">{{randomCocktail.difficulty}}</text>
            <text wx:if="{{randomCocktail.time}}" class="meta-item">{{randomCocktail.time}}</text>
            <text wx:if="{{randomCocktail.ingredients && randomCocktail.ingredients.length}}" class="meta-item">{{randomCocktail.ingredients.length}}种成分</text>
          </view>

          <view class="daily-action">
            <text class="action-text">查看酒谱</text>
            <text class="action-arrow">→</text>
          </view>
        </view>

        <view class="hero-emoji">{{randomCocktail.emoji || '🍸'}}</view>
      </view>

      <view class="search-section">
        <view class="search-bar">
          <text class="search-glyph">⌕</text>
          <input
            bindinput="onSearch"
            placeholder="搜索名称、风味或成分"
            value="{{searchQuery}}"
            class="search-input"
            confirm-type="search"
            maxlength="50"
          />
          <view wx:if="{{searchQuery}}" class="clear-search" bindtap="clearSearch">
            <text class="clear-icon">×</text>
          </view>
        </view>

        <view class="search-status">
          <text wx:if="{{isSearching}}" class="search-loading">正在筛选酒单</text>
          <text wx:elif="{{searchQuery}}" class="search-result">找到 {{filteredCount}} 个配方</text>
          <text wx:else class="total-count">经典、热带、酸甜与自定义配方</text>
        </view>
      </view>

      <view class="cocktail-section">
        <view class="section-heading">
          <text class="section-title">{{searchQuery ? '搜索结果' : '精选酒谱'}}</text>
          <text class="section-count">{{filteredCount}} ITEMS</text>
        </view>

        <view wx:if="{{searchQuery && filteredCount === 0}}" class="no-results">
          <text class="no-results-mark">⌕</text>
          <text class="no-results-text">未找到相关配方</text>
          <text class="no-results-tip">换一个酒名、材料或风味关键词试试</text>
          <button class="clear-search-btn" bindtap="clearSearch">清除搜索</button>
        </view>

        <block wx:else>
          <view
            wx:for="{{filteredCocktails}}"
            wx:key="id"
            wx:for-item="cocktail"
            data-id="{{cocktail.id}}"
            data-name="{{cocktail.name}}"
            bindtap="navigateToCocktailDetail"
            class="cocktail-card scale-in"
            style="animation-delay: {{index * 0.04}}s"
          >
            <view class="cocktail-symbol">
              <text class="cocktail-emoji">{{cocktail.emoji || '🍸'}}</text>
              <text class="cocktail-index">{{cocktail.listIndex}}</text>
            </view>

            <view class="cocktail-content">
              <view class="cocktail-header">
                <text class="cocktail-name">{{cocktail.name}}</text>
                <text class="category-text">{{cocktail.category || '经典'}}</text>
              </view>

              <text class="cocktail-desc">{{cocktail.description}}</text>

              <view class="cocktail-features">
                <text class="feature-item">{{cocktail.sourceText}}</text>
                <text wx:if="{{cocktail.difficulty}}" class="feature-item">{{cocktail.difficulty}}</text>
                <text wx:if="{{cocktail.time}}" class="feature-item">{{cocktail.time}}</text>
                <text wx:if="{{cocktail.ingredients && cocktail.ingredients.length}}" class="feature-item">{{cocktail.ingredients.length}} 种成分</text>
              </view>

              <view wx:if="{{cocktail.ingredients && cocktail.ingredients.length > 0}}" class="ingredients-preview">
                <text class="ingredients-label">主要成分</text>
                <text class="ingredients-text">{{cocktail.ingredientsPreview}}</text>
              </view>
            </view>

            <view class="cocktail-action">
              <text class="action-arrow">→</text>
            </view>
          </view>

          <view wx:if="{{!hasMore && filteredCount > 0}}" class="no-more">
            <text class="no-more-text">已显示全部配方</text>
          </view>
        </block>
      </view>
    </view>

    <view wx:elif="{{activeMainTab === 'add'}}" class="main-tab-panel add-cocktail-panel {{mainTabTransitionClass}}">
      <view class="form-header add-form-header">
        <view>
          <text class="eyebrow">NEW RECIPE</text>
          <text class="form-title">添加自定义配方</text>
          <text class="form-subtitle">记录名称、成分和制作步骤，保存后会进入本机配方库</text>
        </view>
        <view class="add-preview-symbol">{{emoji}}</view>
      </view>

      <view class="form-section">
        <view class="form-group">
          <text class="form-label">配方名称*</text>
          <input
            class="form-input {{formErrors.name ? 'error' : ''}}"
            bindinput="onInputName"
            placeholder="不超过20个字符"
            placeholder-class="preview-placeholder"
            value="{{cocktailName}}"
            maxlength="20"
          />
          <text wx:if="{{formErrors.name}}" class="error-message">{{formErrors.name}}</text>
        </view>

        <view class="form-group">
          <text class="form-label">简介</text>
          <textarea
            class="form-input form-textarea {{formErrors.description ? 'error' : ''}}"
            bindinput="onInputDescription"
            placeholder="可不填，保存时显示为-"
            placeholder-class="preview-placeholder"
            value="{{cocktailDescription}}"
            maxlength="100"
            auto-height="true"
            show-count="true"
          />
          <text wx:if="{{formErrors.description}}" class="error-message">{{formErrors.description}}</text>
        </view>

        <view class="form-grid">
          <view class="form-group form-grid-item">
            <text class="form-label">分类</text>
            <picker bindchange="onCategoryChange" value="{{categoryIndex}}" range="{{categoryOptions}}">
              <view class="picker-display">
                <text class="picker-text">{{category}}</text>
                <text class="picker-arrow">›</text>
              </view>
            </picker>
          </view>

          <view class="form-group form-grid-item">
            <text class="form-label">图标</text>
            <picker bindchange="onEmojiChange" value="{{emojiIndex}}" range="{{emojiOptions}}">
              <view class="picker-display">
                <text class="picker-emoji">{{emoji}}</text>
                <text class="picker-text">选择</text>
                <text class="picker-arrow">›</text>
              </view>
            </picker>
          </view>
        </view>

        <view class="form-grid">
          <view class="form-group form-grid-item">
            <text class="form-label">难度</text>
            <picker bindchange="onDifficultyChange" value="{{difficultyIndex}}" range="{{difficultyOptions}}">
              <view class="picker-display">
                <text class="picker-text">{{difficulty}}</text>
                <text class="picker-arrow">›</text>
              </view>
            </picker>
          </view>

          <view class="form-group form-grid-item">
            <text class="form-label">制作时间</text>
            <view class="time-picker-row {{formErrors.time ? 'error' : ''}}">
              <picker class="time-picker" bindchange="onTimeNumberChange" value="{{timeNumberIndex}}" range="{{timeNumberOptions}}">
                <view class="time-picker-display">{{timeNumber}}</view>
              </picker>
              <picker class="time-picker" bindchange="onTimeUnitChange" value="{{timeUnitIndex}}" range="{{timeUnitOptions}}">
                <view class="time-picker-display">{{timeUnit}}</view>
              </picker>
            </view>
            <text wx:if="{{formErrors.time}}" class="error-message">{{formErrors.time}}</text>
          </view>
        </view>
      </view>

      <view class="form-section">
        <view class="section-title-row">
          <text class="form-section-title">配方成分*</text>
          <text class="section-mini-label">{{ingredients.length}}/30</text>
        </view>

        <view class="ingredient-input-group">
          <input
            class="ingredient-input"
            bindinput="onInputIngredient"
            placeholder="输入成分名称"
            placeholder-class="preview-placeholder"
            value="{{newIngredient}}"
            maxlength="20"
          />
          <button class="add-ingredient-btn" bindtap="addIngredient">添加</button>
        </view>

        <view class="ingredients-list" wx:if="{{ingredients.length > 0}}">
          <view class="ingredient-item" wx:for="{{ingredients}}" wx:key="index">
            <text class="ingredient-name">{{item}}</text>
            <button class="remove-ingredient-btn" bindtap="removeIngredient" data-index="{{index}}">×</button>
          </view>
        </view>

        <text wx:if="{{formErrors.ingredients}}" class="error-message">{{formErrors.ingredients}}</text>
      </view>

      <view class="form-section">
        <view class="section-title-row">
          <text class="form-section-title">制作步骤*</text>
          <text class="section-mini-label">{{steps.length}}/30</text>
        </view>

        <block wx:for="{{steps}}" wx:key="number">
          <view class="step-form-group">
            <view class="step-header">
              <text class="step-number">步骤 {{item.number}}</text>
              <view class="step-tools">
                <button wx:if="{{index > 0}}" class="step-tool-btn" bindtap="moveStepUp" data-index="{{index}}">上移</button>
                <button wx:if="{{index < steps.length - 1}}" class="step-tool-btn" bindtap="moveStepDown" data-index="{{index}}">下移</button>
                <button wx:if="{{steps.length > 1}}" class="step-tool-btn danger" bindtap="removeStep" data-index="{{index}}">移除</button>
              </view>
            </view>

            <textarea
              class="form-input form-textarea step-input {{formErrors.steps ? 'error' : ''}}"
              bindinput="onInputStep"
              data-index="{{index}}"
              placeholder="描述倒酒顺序、调制手法或装饰要求"
              placeholder-class="preview-placeholder"
              value="{{item.instruction}}"
              maxlength="200"
              auto-height="true"
              show-count="true"
            />
          </view>
        </block>

        <text wx:if="{{formErrors.steps}}" class="error-message">{{formErrors.steps}}</text>
        <button class="add-step-button" bindtap="addStep">+ 添加步骤</button>
      </view>

      <view class="action-buttons">
        <button class="cancel-button" bindtap="returnHomeTab">取消</button>
        <button class="save-button" loading="{{isSaving}}" disabled="{{isSaving}}" bindtap="saveCocktail">保存配方</button>
      </view>
    </view>

    <view wx:elif="{{activeMainTab === 'mine'}}" class="main-tab-panel mine-panel {{mainTabTransitionClass}}">
      <view class="mine-header">
        <text class="eyebrow">LOCAL CELLAR</text>
        <text class="page-title">我的配方</text>
        <text class="mine-subtitle">本机个人空间只管理当前设备上的自定义配方</text>
      </view>

      <view class="mine-stats">
        <view class="mine-stat">
          <text class="mine-stat-value">{{customCount}}</text>
          <text class="mine-stat-label">自定义配方</text>
        </view>
        <view class="mine-stat">
          <text class="mine-stat-value">{{totalCount}}</text>
          <text class="mine-stat-label">可浏览配方</text>
        </view>
      </view>

      <view class="mine-actions">
        <view class="mine-entry" bindtap="navigateToCustomCocktails">
          <view class="entry-code">LIST</view>
          <view class="entry-copy">
            <text class="entry-title">自定义配方管理</text>
            <text class="entry-desc">查看、编辑、删除和批量管理本机自定义配方</text>
          </view>
          <text class="entry-arrow">→</text>
        </view>

        <view class="mine-entry" bindtap="navigateToImport">
          <view class="entry-code">IN</view>
          <view class="entry-copy">
            <text class="entry-title">配方导入</text>
            <text class="entry-desc">粘贴配方导入码，预览确认后保存到本机</text>
          </view>
          <text class="entry-arrow">→</text>
        </view>
      </view>
    </view>
  </block>

  <view class="inline-tab-shell" wx:if="{{!isLoading && !error}}">
    <view class="inline-tab-panel">
      <view
        wx:for="{{mainTabs}}"
        wx:key="tab"
        class="inline-tab-item {{activeMainTab === item.tab ? 'is-active' : ''}}"
        data-tab="{{item.tab}}"
        bindtap="switchMainTab"
      >
        <view class="inline-tab-code">{{item.code}}</view>
        <view class="inline-tab-copy">
          <text class="inline-tab-text">{{item.text}}</text>
          <text class="inline-tab-action">{{item.action}}</text>
        </view>
      </view>
    </view>
  </view>
</view>

<view class="sr-only" aria-live="polite">
  <text wx:if="{{isLoading}}">页面正在加载</text>
  <text wx:elif="{{error}}">页面加载出错：{{error.message}}</text>
  <text wx:elif="{{isSearching}}">正在搜索配方</text>
</view>
