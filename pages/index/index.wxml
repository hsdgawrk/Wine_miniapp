<view class="container index-page">
  <view wx:if="{{isLoading}}" class="loading">
    <loading class="loading-spinner" type="dot-gray" />
    <text class="loading-text">加载中...</text>
  </view>

  <view wx:elif="{{error}}" class="error-container">
    <text class="error-text">{{error.message}}</text>
    <text class="error-context">操作：{{error.context}}</text>
    <button class="retry-btn" bindtap="retryOperation">重试</button>
  </view>

  <block wx:else>
    <view wx:if="{{activeMainTab === 'home'}}" class="main-tab-panel {{mainTabTransitionClass}}">
    <view class="top-strip">
      <view>
        <text class="eyebrow">BAR INDEX</text>
        <text class="page-title">今晚喝什么</text>
      </view>
      <view class="library-stat">
        <text class="library-stat-value">{{totalCount}}</text>
        <text class="library-stat-label">配方</text>
      </view>
    </view>

    <view
      wx:if="{{randomCocktail}}"
      class="daily-cocktail-card slide-up"
      bindtap="onDailyRecommendTap"
      aria-label="每日推荐配方"
    >
      <view class="date-plate">
        <text class="date-month">{{currentDate.month}}</text>
        <text class="date-day">{{currentDate.day}}</text>
        <text class="date-weekday">{{currentDate.weekday}}</text>
      </view>

      <view class="daily-content">
        <view class="daily-kicker">
          <text class="daily-label">今日特调</text>
          <text class="daily-year">{{currentDate.year}}</text>
        </view>
        <text class="daily-cocktail-title">{{randomCocktail.name}}</text>
        <text class="daily-cocktail-description">{{randomCocktail.description}}</text>

        <view wx:if="{{randomCocktail.difficulty || randomCocktail.time || (randomCocktail.ingredients && randomCocktail.ingredients.length)}}" class="daily-meta">
          <text wx:if="{{randomCocktail.difficulty}}" class="meta-item">{{randomCocktail.difficulty}}</text>
          <text wx:if="{{randomCocktail.time}}" class="meta-item">{{randomCocktail.time}}</text>
          <text wx:if="{{randomCocktail.ingredients && randomCocktail.ingredients.length}}" class="meta-item">{{randomCocktail.ingredients.length}}种成分</text>
        </view>

        <view class="daily-action">
          <text class="action-text">查看酒谱</text>
          <text class="action-arrow">→</text>
        </view>
      </view>

      <view class="hero-emoji">{{randomCocktail.emoji || '🍸'}}</view>
    </view>

    <view class="search-section">
      <view class="search-bar">
        <text class="search-glyph">⌕</text>
        <input
          bindinput="onSearch"
          placeholder="搜索名称、风味或成分"
          value="{{searchQuery}}"
          class="search-input"
          confirm-type="search"
          maxlength="50"
          aria-label="搜索配方"
        />
        <view
          wx:if="{{searchQuery}}"
          class="clear-search"
          bindtap="clearSearch"
          aria-label="清除搜索"
        >
          <text class="clear-icon">×</text>
        </view>
      </view>

      <view class="search-status">
        <text wx:if="{{isSearching}}" class="search-loading">正在筛选酒单</text>
        <text wx:elif="{{searchQuery}}" class="search-result">找到 {{filteredCount}} 个配方</text>
        <text wx:else class="total-count">经典、热带、酸甜与自定义配方</text>
      </view>
    </view>

    <view class="cocktail-section">
      <view class="section-heading">
        <text class="section-title">{{searchQuery ? '搜索结果' : '精选酒谱'}}</text>
        <text class="section-count">{{filteredCount}} ITEMS</text>
      </view>

      <view wx:if="{{searchQuery && filteredCount === 0}}" class="no-results">
        <text class="no-results-mark">⌕</text>
        <text class="no-results-text">未找到相关配方</text>
        <text class="no-results-tip">换一个酒名、材料或风味关键词试试</text>
        <button class="clear-search-btn" bindtap="clearSearch">清除搜索</button>
      </view>

      <block wx:else>
        <view
          wx:for="{{filteredCocktails}}"
          wx:key="id"
          wx:for-item="cocktail"
          data-id="{{cocktail.id}}"
          data-name="{{cocktail.name}}"
          bindtap="navigateToCocktailDetail"
          class="cocktail-card scale-in"
          style="animation-delay: {{index * 0.04}}s"
          aria-label="{{cocktail.name}}配方"
        >
          <view class="cocktail-symbol">
            <text class="cocktail-emoji">{{cocktail.emoji || '🍸'}}</text>
            <text class="cocktail-index">{{cocktail.listIndex}}</text>
          </view>

          <view class="cocktail-content">
            <view class="cocktail-header">
              <text class="cocktail-name">{{cocktail.name}}</text>
              <text class="category-text">{{cocktail.category || '经典'}}</text>
            </view>

            <text class="cocktail-desc">{{cocktail.description}}</text>

            <view class="cocktail-features">
              <text wx:if="{{cocktail.difficulty}}" class="feature-item">{{cocktail.difficulty}}</text>
              <text wx:if="{{cocktail.time}}" class="feature-item">{{cocktail.time}}</text>
              <text wx:if="{{cocktail.ingredients && cocktail.ingredients.length}}" class="feature-item">{{cocktail.ingredients.length}} 种成分</text>
              <text wx:if="{{cocktail.popularity}}" class="feature-item hot">{{cocktail.popularity}}% 热度</text>
            </view>

            <view wx:if="{{cocktail.ingredients && cocktail.ingredients.length > 0}}" class="ingredients-preview">
              <text class="ingredients-label">主要成分</text>
              <text class="ingredients-text">{{cocktail.ingredientsPreview}}</text>
            </view>
          </view>

          <view class="cocktail-action">
            <text class="action-arrow">→</text>
          </view>
        </view>

        <view wx:if="{{!hasMore && filteredCount > 0}}" class="no-more">
          <text class="no-more-text">已显示全部配方</text>
        </view>
      </block>
    </view>
    </view>

    <view wx:elif="{{activeMainTab === 'add'}}" class="main-tab-panel add-cocktail-panel {{mainTabTransitionClass}}">
      <view class="form-header add-preview-header">
        <view>
          <text class="eyebrow">NEW RECIPE</text>
          <text class="form-title">添加新配方</text>
          <text class="form-subtitle">酒款信息、成分和步骤的录入界面预览</text>
        </view>
        <view class="add-preview-symbol">＋</view>
      </view>

      <view class="form-section">
        <view class="form-group">
          <text class="form-label">酒款名称*</text>
          <input
            class="form-input preview-input"
            placeholder="请输入酒名"
            placeholder-class="preview-placeholder"
            maxlength="30"
            disabled="{{true}}"
          />
        </view>

        <view class="form-group">
          <text class="form-label">简介描述*</text>
          <textarea
            class="form-input form-textarea preview-input"
            placeholder="简要描述这款酒的口感、风格或适饮场合"
            placeholder-class="preview-placeholder"
            maxlength="100"
            auto-height="true"
            disabled="{{true}}"
          />
        </view>

        <view class="form-grid">
          <view class="form-group form-grid-item">
            <text class="form-label">酒款分类</text>
            <view class="picker-display preview-picker">
              <text class="picker-text">经典</text>
              <text class="picker-arrow">›</text>
            </view>
          </view>

          <view class="form-group form-grid-item">
            <text class="form-label">配方图标</text>
            <view class="picker-display preview-picker">
              <text class="picker-emoji">🍸</text>
              <text class="picker-text">鸡尾酒</text>
              <text class="picker-arrow">›</text>
            </view>
          </view>
        </view>

        <view class="form-grid">
          <view class="form-group form-grid-item">
            <text class="form-label">制作难度</text>
            <view class="picker-display preview-picker">
              <text class="picker-text">简单</text>
              <text class="picker-arrow">›</text>
            </view>
          </view>

          <view class="form-group form-grid-item">
            <text class="form-label">制作时间</text>
            <input
              class="form-input preview-input"
              placeholder="如：10分钟"
              placeholder-class="preview-placeholder"
              maxlength="20"
              disabled="{{true}}"
            />
          </view>
        </view>
      </view>

      <view class="form-section">
        <view class="section-title-row">
          <text class="form-section-title">配方成分*</text>
          <text class="section-mini-label">{{addPreviewIngredients.length}} SLOT</text>
        </view>

        <view class="ingredient-input-group">
          <input
            class="ingredient-input preview-input"
            placeholder="输入成分名称"
            placeholder-class="preview-placeholder"
            maxlength="20"
            disabled="{{true}}"
          />
          <button class="add-ingredient-btn is-disabled" disabled="{{true}}">添加</button>
        </view>

        <view class="ingredients-list">
          <view
            class="ingredient-item preview-ingredient"
            wx:for="{{addPreviewIngredients}}"
            wx:key="index"
          >
            <text class="ingredient-name">{{item}}</text>
          </view>
        </view>
      </view>

      <view class="form-section">
        <view class="section-title-row">
          <text class="form-section-title">制作步骤*</text>
          <text class="section-mini-label">{{addPreviewSteps.length}} STEP</text>
        </view>

        <block wx:for="{{addPreviewSteps}}" wx:key="number">
          <view class="step-form-group">
            <view class="step-header">
              <text class="step-number">步骤 {{item.number}}</text>
            </view>

            <textarea
              class="form-input form-textarea step-input preview-input"
              placeholder="{{item.placeholder}}"
              placeholder-class="preview-placeholder"
              maxlength="200"
              auto-height="true"
              disabled="{{true}}"
            />
          </view>
        </block>

        <button class="add-step-button is-disabled" disabled="{{true}}">+ 添加步骤</button>
      </view>

      <view class="action-buttons">
        <button class="cancel-button" bindtap="returnHomeTab">取消</button>
        <button class="save-button is-disabled" disabled="{{true}}">保存配方</button>
      </view>
    </view>
  </block>
</view>

<view class="sr-only" aria-live="polite">
  <text wx:if="{{isLoading}}">页面正在加载</text>
  <text wx:elif="{{error}}">页面加载出错：{{error.message}}</text>
  <text wx:elif="{{isSearching}}">正在搜索配方</text>
</view>
