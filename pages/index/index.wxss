page {
  min-height: 100%;
  background: #12110f;
  background-color: #12110f;
}

.index-page {
  position: relative;
  min-height: 100vh;
  padding: 28rpx 24rpx 180rpx;
  box-sizing: border-box;
  background:
    linear-gradient(135deg, rgba(215, 255, 104, 0.08), transparent 30%),
    linear-gradient(245deg, rgba(255, 255, 255, 0.05), transparent 34%),
    linear-gradient(180deg, #171512 0%, #11100e 54%, #1b1813 100%);
  overflow: hidden;
}

.top-strip {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin: 8rpx 0 24rpx;
}

.eyebrow {
  display: block;
  color: #d7ff68;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1;
  margin-bottom: 14rpx;
}

.page-title {
  display: block;
  color: #fff8ee;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.05;
}

.library-stat {
  min-width: 112rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.07);
  text-align: right;
}

.library-stat-value {
  display: block;
  color: #fff8ee;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
}

.library-stat-label {
  display: block;
  color: rgba(247, 241, 232, 0.58);
  font-size: 20rpx;
  margin-top: 8rpx;
}

.daily-cocktail-card {
  position: relative;
  display: flex;
  min-height: 360rpx;
  padding: 26rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background:
    linear-gradient(135deg, rgba(255, 172, 64, 0.24), transparent 42%),
    linear-gradient(145deg, rgba(39, 38, 33, 0.96), rgba(20, 19, 16, 0.94));
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  box-shadow: 0 28rpx 80rpx rgba(0, 0, 0, 0.36);
}

.daily-cocktail-card::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 8rpx;
  background: linear-gradient(90deg, #d7ff68, #ffb84d, #fff8ee);
}

.daily-cocktail-card::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background:
    linear-gradient(90deg, rgba(255, 255, 255, 0.06) 1rpx, transparent 1rpx),
    linear-gradient(180deg, rgba(255, 255, 255, 0.04) 1rpx, transparent 1rpx);
  background-size: 42rpx 42rpx;
  opacity: 0.28;
  pointer-events: none;
}

.daily-cocktail-card:active {
  transform: scale(0.99);
}

.date-plate {
  position: relative;
  z-index: 1;
  width: 132rpx;
  height: 204rpx;
  padding: 18rpx 0;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: #fff8ee;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 18rpx 44rpx rgba(0, 0, 0, 0.28);
}

.date-month,
.date-weekday {
  color: #312a20;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}

.date-day {
  color: #15130f;
  font-size: 66rpx;
  font-weight: 900;
  line-height: 1;
  margin: 18rpx 0 16rpx;
}

.daily-content {
  position: relative;
  z-index: 1;
  flex: 1;
  padding-left: 28rpx;
  padding-right: 76rpx;
  min-width: 0;
}

.daily-kicker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.daily-label {
  display: inline-flex;
  color: #d7ff68;
  font-size: 22rpx;
  font-weight: 800;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(215, 255, 104, 0.34);
  background: rgba(215, 255, 104, 0.1);
}

.daily-year {
  color: rgba(247, 241, 232, 0.48);
  font-size: 22rpx;
  font-weight: 700;
}

.daily-cocktail-title {
  display: block;
  color: #fff8ee;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.08;
  margin-bottom: 18rpx;
}

.daily-cocktail-description {
  display: -webkit-box;
  color: rgba(247, 241, 232, 0.76);
  font-size: 27rpx;
  line-height: 1.52;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.daily-meta {
  display: flex;
  flex-wrap: wrap;
  margin: 22rpx -8rpx 0 0;
}

.meta-item {
  margin: 0 8rpx 8rpx 0;
  padding: 8rpx 14rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.1);
  color: rgba(247, 241, 232, 0.82);
  font-size: 22rpx;
  font-weight: 700;
}

.daily-action {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
}

.action-text {
  color: #fff8ee;
  font-size: 25rpx;
  font-weight: 800;
}

.action-arrow {
  color: #d7ff68;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1;
  margin-left: 12rpx;
}

.hero-emoji {
  position: absolute;
  right: -16rpx;
  bottom: 4rpx;
  z-index: 1;
  font-size: 128rpx;
  opacity: 0.22;
}

.search-section {
  margin: 26rpx 0 16rpx;
}

.search-bar {
  min-height: 96rpx;
  padding: 0 18rpx 0 24rpx;
  display: flex;
  align-items: center;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.09);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
}

.search-glyph {
  width: 44rpx;
  color: #d7ff68;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  color: #fff8ee;
  font-size: 28rpx;
}

.clear-search {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.clear-icon {
  color: rgba(247, 241, 232, 0.8);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
}

.search-status {
  min-height: 44rpx;
  padding: 12rpx 4rpx 0;
}

.search-loading,
.search-result,
.total-count {
  color: rgba(247, 241, 232, 0.56);
  font-size: 24rpx;
}

.search-result {
  color: #d7ff68;
}

.cocktail-section {
  padding-top: 10rpx;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 20rpx 0 16rpx;
}

.section-title {
  color: #fff8ee;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.1;
}

.section-count {
  color: rgba(247, 241, 232, 0.4);
  font-size: 20rpx;
  font-weight: 800;
}

.no-results {
  padding: 72rpx 28rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  text-align: center;
}

.no-results-mark {
  display: block;
  color: #d7ff68;
  font-size: 68rpx;
  line-height: 1;
  margin-bottom: 20rpx;
}

.no-results-text {
  display: block;
  color: #fff8ee;
  font-size: 32rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
}

.no-results-tip {
  display: block;
  color: rgba(247, 241, 232, 0.58);
  font-size: 25rpx;
  margin-bottom: 34rpx;
}

.clear-search-btn {
  width: 260rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0;
  border-radius: 14rpx;
  background: #d7ff68;
  color: #171511;
  font-size: 27rpx;
  font-weight: 800;
}

.cocktail-card {
  position: relative;
  display: flex;
  align-items: stretch;
  min-height: 226rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.075);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  overflow: hidden;
  box-shadow: 0 16rpx 50rpx rgba(0, 0, 0, 0.2);
  transition: transform 0.18s ease, background 0.18s ease;
}

.cocktail-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 100%;
  background: #ffb84d;
}

.cocktail-card:active {
  transform: scale(0.985);
  background: rgba(255, 255, 255, 0.1);
}

.cocktail-symbol {
  width: 126rpx;
  padding: 26rpx 16rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  background: rgba(0, 0, 0, 0.2);
}

.cocktail-emoji {
  font-size: 56rpx;
  line-height: 1;
}

.cocktail-index {
  color: rgba(247, 241, 232, 0.42);
  font-size: 22rpx;
  font-weight: 900;
}

.cocktail-content {
  flex: 1;
  min-width: 0;
  padding: 26rpx 14rpx 24rpx 24rpx;
  box-sizing: border-box;
}

.cocktail-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.cocktail-name {
  flex: 1;
  min-width: 0;
  color: #fff8ee;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.18;
  margin-right: 14rpx;
}

.category-text {
  flex-shrink: 0;
  max-width: 132rpx;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  color: #15130f;
  background: #fff8ee;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cocktail-desc {
  display: -webkit-box;
  color: rgba(247, 241, 232, 0.66);
  font-size: 25rpx;
  line-height: 1.48;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.cocktail-features {
  display: flex;
  flex-wrap: wrap;
  margin-right: -8rpx;
  margin-bottom: 14rpx;
}

.feature-item {
  margin: 0 8rpx 8rpx 0;
  padding: 7rpx 11rpx;
  border-radius: 10rpx;
  color: rgba(247, 241, 232, 0.76);
  background: rgba(255, 255, 255, 0.08);
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.1;
}

.feature-item.hot {
  color: #d7ff68;
  background: rgba(215, 255, 104, 0.1);
}

.ingredients-preview {
  display: flex;
  align-items: center;
  min-width: 0;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.ingredients-label {
  flex-shrink: 0;
  color: rgba(247, 241, 232, 0.44);
  font-size: 21rpx;
  font-weight: 800;
  margin-right: 12rpx;
}

.ingredients-text {
  flex: 1;
  min-width: 0;
  color: rgba(247, 241, 232, 0.7);
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cocktail-action {
  width: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cocktail-action .action-arrow {
  margin-left: 0;
  color: rgba(215, 255, 104, 0.88);
}

.no-more {
  padding: 34rpx 0 14rpx;
  text-align: center;
}

.no-more-text {
  color: rgba(247, 241, 232, 0.38);
  font-size: 23rpx;
  font-weight: 700;
}

.error-context {
  color: rgba(247, 241, 232, 0.58);
  font-size: 24rpx;
  margin-bottom: 28rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
}

.main-tab-panel {
  min-height: calc(100vh - 208rpx);
}

.main-tab-enter {
  animation: mainTabEnter 0.26s ease-out both;
}

.add-cocktail-panel {
  padding-top: 4rpx;
}

.form-header {
  padding: 34rpx 30rpx;
  border-radius: 16rpx;
  background:
    linear-gradient(135deg, rgba(215, 255, 104, 0.14), transparent 48%),
    rgba(255, 255, 255, 0.075);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 20rpx 58rpx rgba(0, 0, 0, 0.22);
}

.add-preview-header {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  overflow: hidden;
}

.add-preview-header::after {
  content: '';
  position: absolute;
  right: -80rpx;
  bottom: -86rpx;
  width: 250rpx;
  height: 250rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(215, 255, 104, 0.18);
  background: rgba(215, 255, 104, 0.05);
}

.form-title {
  display: block;
  color: #fff8ee;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.1;
  margin-bottom: 14rpx;
}

.form-subtitle {
  display: block;
  color: rgba(247, 241, 232, 0.62);
  font-size: 26rpx;
  line-height: 1.5;
}

.add-preview-symbol {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  line-height: 84rpx;
  border-radius: 16rpx;
  background: #d7ff68;
  color: #15130f;
  font-size: 56rpx;
  font-weight: 900;
  text-align: center;
  box-shadow: 0 18rpx 42rpx rgba(215, 255, 104, 0.2);
}

.form-section {
  margin-top: 18rpx;
  padding: 30rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.075);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 16rpx 46rpx rgba(0, 0, 0, 0.18);
}

.form-group {
  margin-bottom: 32rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-grid {
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.form-grid:last-child {
  margin-bottom: 0;
}

.form-grid-item {
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
}

.form-grid-item + .form-grid-item {
  margin-left: 16rpx;
}

.form-label,
.form-section-title {
  display: block;
  color: #fff8ee;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.2;
  margin-bottom: 18rpx;
}

.form-section-title {
  font-size: 32rpx;
  margin-bottom: 0;
}

.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 26rpx;
}

.section-mini-label {
  flex-shrink: 0;
  color: rgba(247, 241, 232, 0.42);
  font-size: 20rpx;
  font-weight: 900;
}

.form-input,
.ingredient-input {
  width: 100%;
  min-height: 92rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.08);
  color: #fff8ee;
  font-size: 28rpx;
}

.form-textarea {
  min-height: 144rpx;
  line-height: 1.6;
}

.preview-input {
  color: rgba(247, 241, 232, 0.56);
  background: rgba(255, 255, 255, 0.065);
}

.preview-placeholder {
  color: rgba(247, 241, 232, 0.34);
}

.picker-display {
  min-height: 92rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
}

.preview-picker {
  background: rgba(255, 255, 255, 0.065);
}

.picker-text {
  flex: 1;
  min-width: 0;
  color: rgba(247, 241, 232, 0.72);
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-arrow {
  flex-shrink: 0;
  color: rgba(215, 255, 104, 0.56);
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1;
}

.picker-emoji {
  flex-shrink: 0;
  font-size: 40rpx;
  line-height: 1;
  margin-right: 16rpx;
}

.ingredient-input-group {
  display: flex;
  align-items: stretch;
  margin-bottom: 24rpx;
}

.ingredient-input {
  flex: 1;
  min-width: 0;
}

.add-ingredient-btn {
  width: 136rpx;
  margin-left: 12rpx;
  min-height: 92rpx;
  line-height: 92rpx;
  padding: 0;
  border-radius: 14rpx;
  background: #d7ff68;
  color: #15130f;
  font-size: 27rpx;
  font-weight: 900;
}

.ingredients-list {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx -10rpx 0;
}

.ingredient-item {
  display: flex;
  align-items: center;
  max-width: 100%;
  margin: 0 10rpx 10rpx 0;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.11);
}

.preview-ingredient {
  background: rgba(215, 255, 104, 0.08);
  border-color: rgba(215, 255, 104, 0.18);
}

.ingredient-name {
  max-width: 460rpx;
  color: rgba(247, 241, 232, 0.82);
  font-size: 25rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.step-form-group {
  margin-bottom: 28rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.step-form-group:last-of-type {
  border-bottom: none;
}

.step-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.step-number {
  color: #d7ff68;
  font-size: 26rpx;
  font-weight: 900;
}

.step-input {
  background: rgba(255, 255, 255, 0.07);
}

.add-step-button {
  height: 82rpx;
  line-height: 82rpx;
  padding: 0;
  border-radius: 14rpx;
  border: 1rpx solid rgba(215, 255, 104, 0.42);
  background: rgba(215, 255, 104, 0.1);
  color: #d7ff68;
  font-size: 27rpx;
  font-weight: 900;
}

.action-buttons {
  display: flex;
  margin-top: 20rpx;
}

.cancel-button,
.save-button {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.cancel-button {
  background: rgba(255, 255, 255, 0.09);
  color: rgba(247, 241, 232, 0.82);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
}

.save-button {
  margin-left: 14rpx;
  background: #d7ff68;
  color: #15130f;
  box-shadow: 0 18rpx 42rpx rgba(215, 255, 104, 0.18);
}

.cancel-button:active {
  transform: scale(0.98);
}

.is-disabled {
  opacity: 0.48;
}

button[disabled].is-disabled {
  color: rgba(21, 19, 15, 0.62);
  background: rgba(215, 255, 104, 0.38);
}

@keyframes mainTabEnter {
  from {
    transform: translateY(18rpx);
    opacity: 0.94;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@media (max-width: 750rpx) {
  .index-page {
    padding-left: 20rpx;
    padding-right: 20rpx;
  }

  .daily-cocktail-card {
    min-height: 342rpx;
    padding: 22rpx;
  }

  .date-plate {
    width: 118rpx;
    height: 188rpx;
  }

  .daily-content {
    padding-left: 22rpx;
    padding-right: 42rpx;
  }

  .daily-cocktail-title {
    font-size: 42rpx;
  }

  .cocktail-symbol {
    width: 112rpx;
  }

  .form-header,
  .form-section {
    padding-left: 26rpx;
    padding-right: 26rpx;
  }

  .add-preview-symbol {
    width: 78rpx;
    height: 78rpx;
    line-height: 74rpx;
    font-size: 48rpx;
    margin-left: 18rpx;
  }
}
