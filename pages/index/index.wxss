page {
  min-height: 100%;
  background: #12110f;
  background-color: #12110f;
}

.index-page {
  position: relative;
  min-height: 100vh;
  padding: 28rpx 24rpx 198rpx;
  box-sizing: border-box;
  background:
    linear-gradient(135deg, rgba(215, 255, 104, 0.08), transparent 30%),
    linear-gradient(245deg, rgba(255, 255, 255, 0.05), transparent 34%),
    linear-gradient(180deg, #171512 0%, #11100e 54%, #1b1813 100%);
  overflow: hidden;
}

.top-strip {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin: 8rpx 0 24rpx;
}

.home-atmosphere {
  position: absolute;
  top: -130rpx;
  left: -24rpx;
  right: -24rpx;
  height: 720rpx;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}

.home-atmosphere::before {
  content: '';
  position: absolute;
  top: 34rpx;
  left: 30rpx;
  right: 18rpx;
  height: 520rpx;
  background:
    linear-gradient(105deg, transparent 0%, rgba(215, 255, 104, 0.14) 18%, transparent 33%),
    linear-gradient(76deg, transparent 11%, rgba(255, 248, 238, 0.07) 41%, transparent 56%),
    repeating-linear-gradient(112deg, rgba(255, 255, 255, 0.055) 0 1rpx, transparent 1rpx 28rpx);
  opacity: 0.55;
  transform: rotate(-5deg);
  animation: liquidPrism 11s ease-in-out infinite alternate;
}

.home-ribbon {
  position: absolute;
  height: 170rpx;
  border-radius: 999rpx;
  filter: blur(12rpx);
  opacity: 0.3;
  transform-origin: center;
}

.home-ribbon-lime {
  top: 24rpx;
  left: -190rpx;
  width: 780rpx;
  background: linear-gradient(96deg, transparent 4%, rgba(215, 255, 104, 0.2) 32%, rgba(255, 248, 238, 0.05) 51%, transparent 76%);
  transform: rotate(-13deg);
  animation: ribbonDriftLime 13s ease-in-out infinite;
}

.home-ribbon-amber {
  top: 250rpx;
  right: -260rpx;
  width: 840rpx;
  background: linear-gradient(82deg, transparent 6%, rgba(255, 184, 77, 0.16) 34%, rgba(255, 122, 102, 0.06) 55%, transparent 78%);
  transform: rotate(10deg);
  animation: ribbonDriftAmber 15s ease-in-out infinite;
}

.home-caustic {
  position: absolute;
  top: 112rpx;
  right: -18rpx;
  width: 520rpx;
  height: 330rpx;
  background:
    repeating-linear-gradient(118deg, transparent 0 34rpx, rgba(215, 255, 104, 0.08) 35rpx 37rpx, transparent 38rpx 68rpx),
    linear-gradient(134deg, transparent 8%, rgba(255, 248, 238, 0.08) 46%, transparent 70%);
  opacity: 0.42;
  transform: skewX(-12deg) rotate(-4deg);
  animation: causticSlide 16s ease-in-out infinite alternate;
}

.eyebrow {
  display: block;
  color: #d7ff68;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1;
  margin-bottom: 14rpx;
}

.page-title {
  display: block;
  color: #fff8ee;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.05;
}

.library-stat {
  min-width: 112rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.07);
  text-align: right;
}

.library-stat-value {
  display: block;
  color: #fff8ee;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
}

.library-stat-label {
  display: block;
  color: rgba(247, 241, 232, 0.58);
  font-size: 20rpx;
  margin-top: 8rpx;
}

.daily-cocktail-card {
  position: relative;
  z-index: 1;
  display: flex;
  min-height: 360rpx;
  padding: 26rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background:
    linear-gradient(135deg, rgba(255, 172, 64, 0.24), transparent 42%),
    linear-gradient(145deg, rgba(39, 38, 33, 0.96), rgba(20, 19, 16, 0.94));
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  box-shadow: 0 28rpx 80rpx rgba(0, 0, 0, 0.36);
}

.daily-card-aura {
  position: absolute;
  top: -120rpx;
  left: -140rpx;
  width: 520rpx;
  height: 520rpx;
  border-radius: 44% 56% 50% 50%;
  background:
    radial-gradient(ellipse at center, rgba(215, 255, 104, 0.16), rgba(255, 184, 77, 0.08) 38%, transparent 67%);
  filter: blur(18rpx);
  opacity: 0.58;
  transform: rotate(-18deg);
  animation: cardAura 9s ease-in-out infinite alternate;
  pointer-events: none;
}

.daily-cocktail-card::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 8rpx;
  background: linear-gradient(90deg, #d7ff68, #ffb84d, #fff8ee);
  background-size: 220% 100%;
  animation: accentPour 5.8s ease-in-out infinite;
}

.daily-cocktail-card::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background:
    linear-gradient(90deg, rgba(255, 255, 255, 0.06) 1rpx, transparent 1rpx),
    linear-gradient(180deg, rgba(255, 255, 255, 0.04) 1rpx, transparent 1rpx);
  background-size: 42rpx 42rpx;
  opacity: 0.28;
  pointer-events: none;
}

.daily-cocktail-card:active {
  transform: scale(0.99);
}

.date-plate {
  position: relative;
  z-index: 1;
  width: 132rpx;
  height: 204rpx;
  padding: 18rpx 0;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: #fff8ee;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 18rpx 44rpx rgba(0, 0, 0, 0.28);
}

.date-month,
.date-weekday {
  color: #312a20;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}

.date-day {
  color: #15130f;
  font-size: 66rpx;
  font-weight: 900;
  line-height: 1;
  margin: 18rpx 0 16rpx;
}

.daily-content {
  position: relative;
  z-index: 1;
  flex: 1;
  padding-left: 28rpx;
  padding-right: 76rpx;
  min-width: 0;
}

.daily-kicker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.daily-label {
  display: inline-flex;
  color: #d7ff68;
  font-size: 22rpx;
  font-weight: 800;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(215, 255, 104, 0.34);
  background: rgba(215, 255, 104, 0.1);
}

.daily-year {
  color: rgba(247, 241, 232, 0.48);
  font-size: 22rpx;
  font-weight: 700;
}

.daily-cocktail-title {
  display: block;
  color: #fff8ee;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.08;
  margin-bottom: 18rpx;
}

.daily-cocktail-description {
  display: -webkit-box;
  color: rgba(247, 241, 232, 0.76);
  font-size: 27rpx;
  line-height: 1.52;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.daily-meta {
  display: flex;
  flex-wrap: wrap;
  margin: 22rpx -8rpx 0 0;
}

.meta-item {
  margin: 0 8rpx 8rpx 0;
  padding: 8rpx 14rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.1);
  color: rgba(247, 241, 232, 0.82);
  font-size: 22rpx;
  font-weight: 700;
}

.daily-action {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
}

.action-text {
  color: #fff8ee;
  font-size: 25rpx;
  font-weight: 800;
}

.action-arrow {
  color: #d7ff68;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1;
  margin-left: 12rpx;
}

.hero-emoji {
  position: absolute;
  right: -16rpx;
  bottom: 4rpx;
  z-index: 1;
  font-size: 128rpx;
  opacity: 0.22;
  animation: garnishFloat 7.2s ease-in-out infinite;
}

.search-section {
  position: relative;
  z-index: 1;
  margin: 26rpx 0 16rpx;
}

.search-bar {
  min-height: 96rpx;
  padding: 0 18rpx 0 24rpx;
  display: flex;
  align-items: center;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.09);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
}

.search-glyph {
  width: 44rpx;
  color: #d7ff68;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  color: #fff8ee;
  font-size: 28rpx;
}

.clear-search {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.clear-icon {
  color: rgba(247, 241, 232, 0.8);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
}

.search-status {
  min-height: 44rpx;
  padding: 12rpx 4rpx 0;
}

.search-loading,
.search-result,
.total-count {
  color: rgba(247, 241, 232, 0.56);
  font-size: 24rpx;
}

.search-result {
  color: #d7ff68;
}

.cocktail-section {
  position: relative;
  z-index: 1;
  padding-top: 10rpx;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 20rpx 0 16rpx;
}

.section-title {
  color: #fff8ee;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.1;
}

.section-count {
  color: rgba(247, 241, 232, 0.4);
  font-size: 20rpx;
  font-weight: 800;
}

.no-results {
  padding: 72rpx 28rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  text-align: center;
}

.no-results-mark {
  display: block;
  color: #d7ff68;
  font-size: 68rpx;
  line-height: 1;
  margin-bottom: 20rpx;
}

.no-results-text {
  display: block;
  color: #fff8ee;
  font-size: 32rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
}

.no-results-tip {
  display: block;
  color: rgba(247, 241, 232, 0.58);
  font-size: 25rpx;
  margin-bottom: 34rpx;
}

.clear-search-btn {
  width: 260rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0;
  border-radius: 14rpx;
  background: #d7ff68;
  color: #171511;
  font-size: 27rpx;
  font-weight: 800;
}

.cocktail-card {
  position: relative;
  display: flex;
  align-items: stretch;
  min-height: 226rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.075);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  overflow: hidden;
  box-shadow: 0 16rpx 50rpx rgba(0, 0, 0, 0.2);
  transition: transform 0.18s ease, background 0.18s ease;
}

.cocktail-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 100%;
  background: #ffb84d;
}

.cocktail-card:active {
  transform: scale(0.985);
  background: rgba(255, 255, 255, 0.1);
}

.cocktail-symbol {
  width: 126rpx;
  padding: 26rpx 16rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  background: rgba(0, 0, 0, 0.2);
}

.cocktail-emoji {
  font-size: 56rpx;
  line-height: 1;
}

.cocktail-index {
  color: rgba(247, 241, 232, 0.42);
  font-size: 22rpx;
  font-weight: 900;
}

.cocktail-content {
  flex: 1;
  min-width: 0;
  padding: 26rpx 14rpx 24rpx 24rpx;
  box-sizing: border-box;
}

.cocktail-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.cocktail-name {
  flex: 1;
  min-width: 0;
  color: #fff8ee;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.18;
  margin-right: 14rpx;
}

.category-text {
  flex-shrink: 0;
  max-width: 132rpx;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  color: #15130f;
  background: #fff8ee;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cocktail-desc {
  display: -webkit-box;
  color: rgba(247, 241, 232, 0.66);
  font-size: 25rpx;
  line-height: 1.48;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.cocktail-features {
  display: flex;
  flex-wrap: wrap;
  margin-right: -8rpx;
  margin-bottom: 14rpx;
}

.feature-item {
  margin: 0 8rpx 8rpx 0;
  padding: 7rpx 11rpx;
  border-radius: 10rpx;
  color: rgba(247, 241, 232, 0.76);
  background: rgba(255, 255, 255, 0.08);
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.1;
}

.feature-item.hot {
  color: #d7ff68;
  background: rgba(215, 255, 104, 0.1);
}

.ingredients-preview {
  display: flex;
  align-items: center;
  min-width: 0;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.ingredients-label {
  flex-shrink: 0;
  color: rgba(247, 241, 232, 0.44);
  font-size: 21rpx;
  font-weight: 800;
  margin-right: 12rpx;
}

.ingredients-text {
  flex: 1;
  min-width: 0;
  color: rgba(247, 241, 232, 0.7);
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cocktail-action {
  width: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cocktail-action .action-arrow {
  margin-left: 0;
  color: rgba(215, 255, 104, 0.88);
}

.no-more {
  padding: 34rpx 0 14rpx;
  text-align: center;
}

.no-more-text {
  color: rgba(247, 241, 232, 0.38);
  font-size: 23rpx;
  font-weight: 700;
}

.error-context {
  color: rgba(247, 241, 232, 0.58);
  font-size: 24rpx;
  margin-bottom: 28rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
}

.main-tab-panel {
  position: relative;
  min-height: calc(100vh - 208rpx);
}

.main-tab-enter {
  animation: mainTabEnter 0.26s ease-out both;
}

.add-cocktail-panel {
  padding-top: 4rpx;
}

.form-header {
  padding: 34rpx 30rpx;
  border-radius: 16rpx;
  background:
    linear-gradient(135deg, rgba(215, 255, 104, 0.14), transparent 48%),
    rgba(255, 255, 255, 0.075);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 20rpx 58rpx rgba(0, 0, 0, 0.22);
}

.add-preview-header,
.add-form-header {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  overflow: hidden;
}

.add-preview-header::after,
.add-form-header::after {
  content: '';
  position: absolute;
  right: -80rpx;
  bottom: -86rpx;
  width: 250rpx;
  height: 250rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(215, 255, 104, 0.18);
  background: rgba(215, 255, 104, 0.05);
}

.form-title {
  display: block;
  color: #fff8ee;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.1;
  margin-bottom: 14rpx;
}

.form-subtitle {
  display: block;
  color: rgba(247, 241, 232, 0.62);
  font-size: 26rpx;
  line-height: 1.5;
}

.add-preview-symbol {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  line-height: 84rpx;
  border-radius: 16rpx;
  background: #d7ff68;
  color: #15130f;
  font-size: 56rpx;
  font-weight: 900;
  text-align: center;
  box-shadow: 0 18rpx 42rpx rgba(215, 255, 104, 0.2);
}

.form-section {
  margin-top: 18rpx;
  padding: 30rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.075);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 16rpx 46rpx rgba(0, 0, 0, 0.18);
}

.form-group {
  margin-bottom: 32rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-grid {
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.form-grid:last-child {
  margin-bottom: 0;
}

.form-grid-item {
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
}

.form-grid-item + .form-grid-item {
  margin-left: 16rpx;
}

.form-label,
.form-section-title {
  display: block;
  color: #fff8ee;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.2;
  margin-bottom: 18rpx;
}

.form-section-title {
  font-size: 32rpx;
  margin-bottom: 0;
}

.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 26rpx;
}

.section-mini-label {
  flex-shrink: 0;
  color: rgba(247, 241, 232, 0.42);
  font-size: 20rpx;
  font-weight: 900;
}

.form-input,
.ingredient-input {
  width: 100%;
  min-height: 92rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.08);
  color: #fff8ee;
  font-size: 28rpx;
}

.form-input.error,
.time-picker-row.error {
  border-color: rgba(255, 122, 102, 0.82);
  background: rgba(255, 122, 102, 0.08);
}

.form-textarea {
  min-height: 144rpx;
  line-height: 1.6;
}

.preview-input {
  color: rgba(247, 241, 232, 0.56);
  background: rgba(255, 255, 255, 0.065);
}

.preview-placeholder {
  color: rgba(247, 241, 232, 0.34);
}

.picker-display {
  min-height: 92rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
}

.preview-picker {
  background: rgba(255, 255, 255, 0.065);
}

.picker-text {
  flex: 1;
  min-width: 0;
  color: rgba(247, 241, 232, 0.72);
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-arrow {
  flex-shrink: 0;
  color: rgba(215, 255, 104, 0.56);
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1;
}

.picker-emoji {
  flex-shrink: 0;
  font-size: 40rpx;
  line-height: 1;
  margin-right: 16rpx;
}

.ingredient-input-group {
  display: flex;
  align-items: stretch;
  margin-bottom: 24rpx;
}

.ingredient-input-group .ingredient-input {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
}

.add-ingredient-btn {
  flex: 0 0 118rpx;
  width: 118rpx;
  margin: 0 0 0 24rpx !important;
  min-height: 92rpx;
  line-height: 92rpx;
  padding: 0;
  border-radius: 14rpx;
  background: #d7ff68;
  color: #15130f;
  font-size: 27rpx;
  font-weight: 900;
}

.ingredients-list {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx -10rpx 0;
}

.ingredient-item {
  display: flex;
  align-items: center;
  max-width: 100%;
  margin: 0 10rpx 10rpx 0;
  padding: 10rpx 10rpx 10rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.11);
}

.remove-ingredient-btn {
  width: 44rpx !important;
  height: 44rpx !important;
  min-height: 44rpx !important;
  line-height: 44rpx !important;
  padding: 0 !important;
  margin-left: 10rpx;
  border-radius: 50%;
  background: rgba(255, 122, 102, 0.14);
  color: #ff7a66;
  font-size: 28rpx;
  font-weight: 900;
}

.preview-ingredient {
  background: rgba(215, 255, 104, 0.08);
  border-color: rgba(215, 255, 104, 0.18);
}

.ingredient-name {
  max-width: 460rpx;
  color: rgba(247, 241, 232, 0.82);
  font-size: 25rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.step-form-group {
  margin-bottom: 28rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.step-form-group:last-of-type {
  border-bottom: none;
}

.step-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.step-tools {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  max-width: 390rpx;
  margin: -8rpx -8rpx 0 18rpx;
}

.step-tool-btn {
  width: 76rpx !important;
  height: 48rpx !important;
  min-height: 48rpx !important;
  line-height: 48rpx !important;
  padding: 0 !important;
  margin: 8rpx 8rpx 0 0;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.08);
  color: rgba(247, 241, 232, 0.82);
  font-size: 22rpx;
  font-weight: 900;
}

.step-tool-btn.danger {
  color: #ff7a66;
  background: rgba(255, 122, 102, 0.12);
}

.step-number {
  color: #d7ff68;
  font-size: 26rpx;
  font-weight: 900;
}

.step-input {
  background: rgba(255, 255, 255, 0.07);
}

.add-step-button {
  height: 82rpx;
  line-height: 82rpx;
  padding: 0;
  border-radius: 14rpx;
  border: 1rpx solid rgba(215, 255, 104, 0.42);
  background: rgba(215, 255, 104, 0.1);
  color: #d7ff68;
  font-size: 27rpx;
  font-weight: 900;
}

.error-message {
  display: block;
  color: #ff7a66;
  font-size: 24rpx;
  line-height: 1.4;
  margin-top: 12rpx;
}

.time-picker-row {
  min-height: 92rpx;
  padding: 0 10rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
}

.time-picker {
  flex: 1;
  min-width: 0;
}

.time-picker + .time-picker {
  margin-left: 10rpx;
}

.time-picker-display {
  height: 70rpx;
  line-height: 70rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  color: #fff8ee;
  background: rgba(255, 255, 255, 0.07);
  font-size: 27rpx;
  font-weight: 800;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-buttons {
  display: flex;
  justify-content: center;
  margin-top: 20rpx;
}

.cancel-button,
.save-button {
  flex: 0 1 300rpx;
  width: 300rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin: 0;
  padding: 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.cancel-button {
  background: rgba(255, 255, 255, 0.09);
  color: rgba(247, 241, 232, 0.82);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
}

.save-button {
  margin-left: 18rpx;
  background: #d7ff68;
  color: #15130f;
  box-shadow: 0 18rpx 42rpx rgba(215, 255, 104, 0.18);
}

.cancel-button:active {
  transform: scale(0.98);
}

.is-disabled {
  opacity: 0.48;
}

button[disabled].is-disabled {
  color: rgba(21, 19, 15, 0.62);
  background: rgba(215, 255, 104, 0.38);
}

.mine-panel {
  padding-top: 4rpx;
}

.mine-header {
  padding: 38rpx 32rpx;
  border-radius: 16rpx;
  background:
    linear-gradient(135deg, rgba(255, 184, 77, 0.16), transparent 46%),
    rgba(255, 255, 255, 0.075);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 20rpx 58rpx rgba(0, 0, 0, 0.22);
}

.mine-subtitle {
  display: block;
  margin-top: 18rpx;
  color: rgba(247, 241, 232, 0.62);
  font-size: 26rpx;
  line-height: 1.5;
}

.mine-stats {
  display: flex;
  margin-top: 18rpx;
}

.mine-stat {
  flex: 1;
  min-height: 150rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.mine-stat + .mine-stat {
  margin-left: 14rpx;
}

.mine-stat-value {
  display: block;
  color: #fff8ee;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1;
}

.mine-stat-label {
  display: block;
  margin-top: 16rpx;
  color: rgba(247, 241, 232, 0.56);
  font-size: 24rpx;
  font-weight: 800;
}

.mine-actions {
  margin-top: 18rpx;
}

.mine-entry {
  display: flex;
  align-items: center;
  min-height: 156rpx;
  margin-bottom: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.075);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 16rpx 46rpx rgba(0, 0, 0, 0.18);
}

.mine-entry:active {
  transform: scale(0.985);
  background: rgba(255, 255, 255, 0.1);
}

.entry-code {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 14rpx;
  background: #d7ff68;
  color: #15130f;
  font-size: 24rpx;
  font-weight: 900;
  text-align: center;
}

.entry-copy {
  flex: 1;
  min-width: 0;
  padding: 0 18rpx;
  box-sizing: border-box;
}

.entry-title {
  display: block;
  color: #fff8ee;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.2;
}

.entry-desc {
  display: block;
  margin-top: 10rpx;
  color: rgba(247, 241, 232, 0.58);
  font-size: 24rpx;
  line-height: 1.42;
}

.entry-arrow {
  flex-shrink: 0;
  color: #d7ff68;
  font-size: 34rpx;
  font-weight: 900;
}

.inline-tab-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding: 16rpx 24rpx 26rpx;
  background: #12110f;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  box-sizing: border-box;
}

.inline-tab-panel {
  height: 104rpx;
  padding: 10rpx;
  border-radius: 16rpx;
  background: #1d1a16;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-sizing: border-box;
  display: flex;
}

.inline-tab-item {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(247, 241, 232, 0.56);
}

.inline-tab-item + .inline-tab-item {
  margin-left: 10rpx;
}

.inline-tab-item.is-active {
  background: #d7ff68;
  color: #15130f;
}

.inline-tab-code {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.08);
  color: inherit;
  font-size: 20rpx;
  font-weight: 900;
}

.inline-tab-item.is-active .inline-tab-code {
  background: rgba(21, 19, 15, 0.12);
}

.inline-tab-copy {
  min-width: 0;
  margin-left: 10rpx;
}

.inline-tab-text {
  display: block;
  color: inherit;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.1;
}

.inline-tab-action {
  display: block;
  margin-top: 6rpx;
  color: inherit;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1;
  opacity: 0.7;
}

@keyframes mainTabEnter {
  from {
    transform: translateY(18rpx);
    opacity: 0.94;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes liquidPrism {
  0% {
    transform: translate3d(-20rpx, 0, 0) rotate(-5deg) skewX(-7deg);
    opacity: 0.34;
  }
  46% {
    transform: translate3d(18rpx, 18rpx, 0) rotate(-2deg) skewX(4deg);
    opacity: 0.58;
  }
  100% {
    transform: translate3d(46rpx, -8rpx, 0) rotate(3deg) skewX(-3deg);
    opacity: 0.42;
  }
}

@keyframes ribbonDriftLime {
  0% {
    transform: translate3d(0, 0, 0) rotate(-13deg) scaleX(1);
  }
  50% {
    transform: translate3d(72rpx, 26rpx, 0) rotate(-9deg) scaleX(1.04);
  }
  100% {
    transform: translate3d(28rpx, -12rpx, 0) rotate(-15deg) scaleX(0.98);
  }
}

@keyframes ribbonDriftAmber {
  0% {
    transform: translate3d(0, 0, 0) rotate(10deg) scaleX(1);
  }
  45% {
    transform: translate3d(-74rpx, 18rpx, 0) rotate(7deg) scaleX(1.06);
  }
  100% {
    transform: translate3d(-30rpx, -20rpx, 0) rotate(12deg) scaleX(0.98);
  }
}

@keyframes causticSlide {
  0% {
    transform: translate3d(0, 0, 0) skewX(-12deg) rotate(-4deg);
    opacity: 0.26;
  }
  100% {
    transform: translate3d(-56rpx, 18rpx, 0) skewX(-6deg) rotate(1deg);
    opacity: 0.44;
  }
}

@keyframes cardAura {
  0% {
    transform: translate3d(0, 0, 0) rotate(-18deg) scale(0.96);
    opacity: 0.34;
  }
  55% {
    transform: translate3d(96rpx, 42rpx, 0) rotate(8deg) scale(1.08);
    opacity: 0.62;
  }
  100% {
    transform: translate3d(54rpx, -16rpx, 0) rotate(16deg) scale(1);
    opacity: 0.46;
  }
}

@keyframes accentPour {
  0%,
  100% {
    opacity: 0.72;
    background-position: 0% 50%;
  }
  50% {
    opacity: 1;
    background-position: 100% 50%;
  }
}

@keyframes garnishFloat {
  0%,
  100% {
    transform: translate3d(0, 0, 0) rotate(-4deg);
    opacity: 0.18;
  }
  50% {
    transform: translate3d(-14rpx, -12rpx, 0) rotate(3deg);
    opacity: 0.26;
  }
}

@media (max-width: 750rpx) {
  .index-page {
    padding-left: 20rpx;
    padding-right: 20rpx;
  }

  .daily-cocktail-card {
    min-height: 342rpx;
    padding: 22rpx;
  }

  .date-plate {
    width: 118rpx;
    height: 188rpx;
  }

  .daily-content {
    padding-left: 22rpx;
    padding-right: 42rpx;
  }

  .daily-cocktail-title {
    font-size: 42rpx;
  }

  .cocktail-symbol {
    width: 112rpx;
  }

  .form-header,
  .form-section {
    padding-left: 26rpx;
    padding-right: 26rpx;
  }

  .add-preview-symbol {
    width: 78rpx;
    height: 78rpx;
    line-height: 74rpx;
    font-size: 48rpx;
    margin-left: 18rpx;
  }

  .step-header {
    align-items: flex-start;
  }

  .step-tools {
    max-width: 300rpx;
  }

  .inline-tab-shell {
    padding-left: 20rpx;
    padding-right: 20rpx;
  }

  .inline-tab-code {
    width: 40rpx;
    height: 40rpx;
    line-height: 40rpx;
    font-size: 18rpx;
  }

  .inline-tab-copy {
    margin-left: 8rpx;
  }

  .inline-tab-text {
    font-size: 23rpx;
  }
}
