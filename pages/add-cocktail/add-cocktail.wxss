page {
  min-height: 100%;
  background: #12110f;
  background-color: #12110f;
}

.container {
  min-height: 100vh;
  padding: 24rpx 24rpx 36rpx;
  box-sizing: border-box;
  background:
    linear-gradient(135deg, rgba(215, 255, 104, 0.07), transparent 30%),
    linear-gradient(180deg, #171512 0%, #11100e 56%, #1b1813 100%);
}

.form-header {
  padding: 34rpx 30rpx;
  border-radius: 16rpx;
  background:
    linear-gradient(135deg, rgba(215, 255, 104, 0.14), transparent 48%),
    rgba(255, 255, 255, 0.075);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 20rpx 58rpx rgba(0, 0, 0, 0.22);
}

.form-title {
  display: block;
  color: #fff8ee;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.1;
  margin-bottom: 14rpx;
}

.form-subtitle {
  display: block;
  color: rgba(247, 241, 232, 0.62);
  font-size: 26rpx;
  line-height: 1.5;
}

.form-section {
  margin-top: 18rpx;
  padding: 30rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.075);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 16rpx 46rpx rgba(0, 0, 0, 0.18);
}

.form-group {
  margin-bottom: 32rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label,
.form-section-title {
  display: block;
  color: #fff8ee;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.2;
  margin-bottom: 18rpx;
}

.form-section-title {
  font-size: 32rpx;
  margin-bottom: 26rpx;
}

.form-input,
.ingredient-input {
  width: 100%;
  min-height: 92rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.08);
  color: #fff8ee;
  font-size: 28rpx;
  transition: border-color 0.2s ease, background 0.2s ease;
}

.form-input:focus,
.ingredient-input:focus {
  border-color: rgba(215, 255, 104, 0.56);
  background: rgba(215, 255, 104, 0.08);
}

.form-input.error {
  border-color: rgba(255, 122, 102, 0.82);
  background: rgba(255, 122, 102, 0.08);
}

.form-textarea {
  min-height: 144rpx;
  line-height: 1.6;
}

.error-message {
  display: block;
  color: #ff7a66;
  font-size: 24rpx;
  line-height: 1.4;
  margin-top: 12rpx;
}

.form-picker {
  width: 100%;
}

.picker-display {
  min-height: 92rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
}

.picker-display:active {
  border-color: rgba(215, 255, 104, 0.56);
  background: rgba(215, 255, 104, 0.08);
}

.picker-text {
  flex: 1;
  min-width: 0;
  color: #fff8ee;
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-arrow {
  flex-shrink: 0;
  color: #d7ff68;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1;
}

.picker-emoji {
  flex-shrink: 0;
  font-size: 40rpx;
  line-height: 1;
  margin-right: 16rpx;
}

.ingredient-input-group {
  display: flex;
  align-items: stretch;
  margin-bottom: 24rpx;
}

.ingredient-input {
  flex: 1;
  min-width: 0;
}

.add-ingredient-btn {
  width: 136rpx;
  margin-left: 12rpx;
  min-height: 92rpx;
  line-height: 92rpx;
  padding: 0;
  border-radius: 14rpx;
  background: #d7ff68;
  color: #15130f;
  font-size: 27rpx;
  font-weight: 900;
}

.add-ingredient-btn:active {
  transform: scale(0.98);
}

.ingredients-list {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx 10rpx 0;
}

.ingredient-item {
  display: flex;
  align-items: center;
  max-width: 100%;
  margin: 0 10rpx 10rpx 0;
  padding: 10rpx 10rpx 10rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.11);
}

.ingredient-name {
  max-width: 460rpx;
  color: rgba(247, 241, 232, 0.82);
  font-size: 25rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.remove-ingredient-btn {
  width: 44rpx !important;
  height: 44rpx !important;
  min-height: 44rpx !important;
  line-height: 44rpx !important;
  padding: 0 !important;
  margin-left: 10rpx;
  border-radius: 50%;
  background: rgba(255, 122, 102, 0.14);
  color: #ff7a66;
  font-size: 28rpx;
  font-weight: 900;
}

.remove-ingredient-btn:active {
  background: #ff7a66;
  color: #15130f;
  transform: scale(0.94);
}

.ingredients-count {
  margin-top: 12rpx;
}

.count-text {
  display: inline-flex;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(215, 255, 104, 0.1);
  color: #d7ff68;
  font-size: 22rpx;
  font-weight: 900;
}

.step-form-group {
  margin-bottom: 28rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.step-form-group:last-of-type {
  border-bottom: none;
}

.step-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.step-number {
  color: #d7ff68;
  font-size: 26rpx;
  font-weight: 900;
}

.remove-step-btn {
  width: 92rpx !important;
  height: 52rpx !important;
  min-height: 52rpx !important;
  line-height: 52rpx !important;
  padding: 0 !important;
  border-radius: 12rpx;
  background: rgba(255, 122, 102, 0.12);
  color: #ff7a66;
  font-size: 24rpx;
  font-weight: 900;
}

.remove-step-btn:active {
  transform: scale(0.96);
}

.step-input {
  background: rgba(255, 255, 255, 0.07);
}

.add-step-button {
  height: 82rpx;
  line-height: 82rpx;
  padding: 0;
  border-radius: 14rpx;
  border: 1rpx solid rgba(215, 255, 104, 0.42);
  background: rgba(215, 255, 104, 0.1);
  color: #d7ff68;
  font-size: 27rpx;
  font-weight: 900;
}

.add-step-button:active {
  transform: scale(0.98);
}

.action-buttons {
  display: flex;
  margin-top: 20rpx;
}

.cancel-button,
.save-button {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.cancel-button {
  background: rgba(255, 255, 255, 0.09);
  color: rgba(247, 241, 232, 0.82);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
}

.save-button {
  margin-left: 14rpx;
  background: #d7ff68;
  color: #15130f;
  box-shadow: 0 18rpx 42rpx rgba(215, 255, 104, 0.18);
}

.cancel-button:active,
.save-button:active {
  transform: scale(0.98);
}

@media (max-width: 750rpx) {
  .container {
    padding-left: 20rpx;
    padding-right: 20rpx;
  }

  .form-header,
  .form-section {
    padding-left: 26rpx;
    padding-right: 26rpx;
  }
}
