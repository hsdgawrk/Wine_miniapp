page {
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  background: #12110f;
  color: #f7f1e8;
  line-height: 1.6;
  letter-spacing: 0;
}

.container {
  padding: 0;
  min-height: 100vh;
}

.glass-card {
  background: rgba(29, 27, 24, 0.86);
  backdrop-filter: blur(28rpx);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 24rpx 70rpx rgba(0, 0, 0, 0.34);
  transition: transform 0.22s ease, border-color 0.22s ease, background 0.22s ease;
}

.btn-primary {
  background: #d7ff68;
  color: #171511;
  border: none;
  border-radius: 16rpx;
  padding: 22rpx 40rpx;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 18rpx 42rpx rgba(215, 255, 104, 0.2);
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}

.btn-primary:active {
  transform: translateY(2rpx) scale(0.98);
  box-shadow: 0 10rpx 26rpx rgba(215, 255, 104, 0.18);
}

.form-input {
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #f7f1e8;
  transition: border-color 0.2s ease, background 0.2s ease;
}

.form-input:focus {
  border-color: #d7ff68;
  box-shadow: 0 0 0 4rpx rgba(215, 255, 104, 0.12);
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.loading-text {
  margin-left: 20rpx;
  font-size: 28rpx;
  color: rgba(247, 241, 232, 0.76);
}

.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.error-text {
  font-size: 28rpx;
  color: #ff7a66;
  text-align: center;
  margin-bottom: 30rpx;
}

.retry-btn {
  background: #ff7a66;
  color: #fff;
  border: none;
  border-radius: 16rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}

button::after {
  border: none;
}

.fade-in {
  animation: fadeIn 0.5s ease-out;
}

.slide-up {
  animation: slideUp 0.45s ease-out;
}

.scale-in {
  animation: scaleIn 0.35s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes slideUp {
  from {
    transform: translateY(34rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes scaleIn {
  from {
    transform: scale(0.96);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

/* 响应式辅助类 */
.text-center {
  text-align: center;
}

.text-left {
  text-align: left;
}

.text-right {
  text-align: right;
}

.mb-small {
  margin-bottom: 20rpx;
}

.mb-medium {
  margin-bottom: 40rpx;
}

.mb-large {
  margin-bottom: 60rpx;
}

.mt-small {
  margin-top: 20rpx;
}

.mt-medium {
  margin-top: 40rpx;
}

.mt-large {
  margin-top: 60rpx;
}

/* 无障碍访问 */
.sr-only {
  position: absolute;
  width: 1rpx;
  height: 1rpx;
  padding: 0;
  margin: -1rpx;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}
